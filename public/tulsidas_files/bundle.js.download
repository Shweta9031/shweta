B,gCAAgC;EAChC,cAAc;EACd,sCAAsC;AACxC;;AAEA,SAAS;AACT;EACE,kBAAkB;EAClB,WAAW;EACX,gBAAgB;EAChB,kBAAkB;EAClB,SAAO;AACT;;AAEA,UAAU;AACV;EACE,qDAAqD;EACrD,6BAA6B;EAC7B,oBAAoB;EACpB,kBAAkB;AACpB;;AAEA;EACE,gBAAgB;EAChB,cAAc;EACd,kBAAkB;EAClB,cAAc;EACd,kBAAkB;EAClB,gBAAgB;EAChB,aAAa;EACb,sBAAsB;EACtB,WAAW;AACb;;AAEA;EACE,kBAAkB;EAClB,WAAW;EACX,kBAAkB;AACpB;;AAEA,eAAe;AACf;EACE,gBAAgB,2BAA2B,EAAE,WAAW,EAAE;EAC1D,oBAAoB,kBAAkB,EAAE,uBAAuB,EAAE;EACjE,cAAc,0BAA0B,EAAE;EAC1C,sBAAsB,yBAAyB,EAAE;EACjD,cAAc,gBAAgB,EAAE,sBAAsB,EAAE;AAC1D","sourcesContent":[".testi-page { min-height: 100vh; }\n\n/* Hero */\n.testi-hero {\n  position: relative;\n  padding: 5rem 2rem;\n  text-align: center;\n  background: radial-gradient(ellipse at center, #1a0800 0%, #0a0a0a 70%);\n  overflow: hidden;\n  border-bottom: 1px solid #1e1e1e;\n}\n\n.testi-hero-glow {\n  position: absolute;\n  top: 50%; left: 50%;\n  transform: translate(-50%, -50%);\n  width: 600px; height: 400px;\n  background: radial-gradient(circle, rgba(255,107,0,0.12) 0%, transparent 70%);\n  pointer-events: none;\n}\n\n.testi-hero-content {\n  position: relative;\n  max-width: 600px;\n  margin: 0 auto;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 1rem;\n}\n\n.testi-om { font-size: 3rem; }\n\n.testi-hero-content h1 {\n  font-size: clamp(1.8rem, 4vw, 2.8rem);\n  font-weight: 800;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n.testi-hero-content p {\n  color: #aaa;\n  font-size: 1rem;\n  line-height: 1.7;\n}\n\n/* Stats */\n.testi-stats {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  background: #0d0d0d;\n  border-bottom: 1px solid #1a1a1a;\n}\n\n.testi-stat {\n  flex: 1;\n  min-width: 130px;\n  text-align: center;\n  padding: 1.8rem 1rem;\n  border-right: 1px solid #1e1e1e;\n}\n\n.testi-stat:last-child { border-right: none; }\n\n.testi-stat span {\n  display: block;\n  font-size: 2rem;\n  font-weight: 800;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  margin-bottom: 0.3rem;\n}\n\n.testi-stat p { color: #777; font-size: 0.82rem; }\n\n/* Filter */\n.testi-filter {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.6rem;\n  justify-content: center;\n  padding: 2rem 2rem 1rem;\n  border-bottom: 1px solid #1a1a1a;\n}\n\n.testi-filter-btn {\n  padding: 0.42rem 1rem;\n  border-radius: 20px;\n  border: 1px solid #2a2a2a;\n  background: #141414;\n  color: #aaa;\n  font-size: 0.8rem;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.2s;\n  font-family: inherit;\n}\n\n.testi-filter-btn:hover { border-color: #FF6B00; color: #FF6B00; }\n\n.testi-filter-btn.active {\n  background: linear-gradient(135deg, #FF6B00, #FF9933);\n  border-color: transparent;\n  color: #fff;\n  font-weight: 600;\n}\n\n/* Grid */\n.testi-grid-section {\n  max-width: 1280px;\n  margin: 0 auto;\n  padding: 2rem 2rem 4rem;\n}\n\n.testi-count {\n  font-size: 0.82rem;\n  color: #555;\n  margin-bottom: 1.5rem;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n\n.testi-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n  gap: 1.5rem;\n}\n\n/* Card */\n.testi-card {\n  background: #141414;\n  border: 1px solid #1e1e1e;\n  border-radius: 14px;\n  padding: 1.4rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.9rem;\n  transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;\n}\n\n.testi-card:hover {\n  transform: translateY(-4px);\n  border-color: #FF6B00;\n  box-shadow: 0 8px 30px rgba(255,107,0,0.12);\n}\n\n.testi-card-top {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n}\n\n.testi-avatar {\n  width: 56px;\n  height: 56px;\n  border-radius: 50%;\n  object-fit: cover;\n  border: 2px solid #FF6B00;\n  flex-shrink: 0;\n}\n\n.testi-info { display: flex; flex-direction: column; gap: 0.2rem; }\n\n.testi-info h3 {\n  font-size: 0.95rem;\n  font-weight: 700;\n  color: #fff5e6;\n}\n\n.testi-city { font-size: 0.75rem; color: #666; }\n\n/* Stars */\n.stars { display: flex; gap: 2px; }\n\n.star { font-size: 0.85rem; color: #333; }\n.star.filled { color: #FFD700; }\n\n/* Badge */\n.testi-badge {\n  display: inline-block;\n  width: fit-content;\n  padding: 3px 10px;\n  border-radius: 20px;\n  font-size: 0.68rem;\n  font-weight: 600;\n  background: rgba(255,107,0,0.15);\n  color: #FF9933;\n  border: 1px solid rgba(255,107,0,0.25);\n}\n\n/* Text */\n.testi-text {\n  font-size: 0.85rem;\n  color: #999;\n  line-height: 1.7;\n  font-style: italic;\n  flex: 1;\n}\n\n/* Quote */\n.testi-quote {\n  background: linear-gradient(135deg, #1a0800, #0d0d0d);\n  border-top: 1px solid #2a1200;\n  padding: 3.5rem 2rem;\n  text-align: center;\n}\n\n.testi-quote blockquote {\n  max-width: 580px;\n  margin: 0 auto;\n  font-size: 1.25rem;\n  color: #FFD700;\n  font-style: italic;\n  line-height: 1.8;\n  display: flex;\n  flex-direction: column;\n  gap: 0.8rem;\n}\n\n.testi-quote cite {\n  font-size: 0.85rem;\n  color: #666;\n  font-style: normal;\n}\n\n/* Responsive */\n@media (max-width: 600px) {\n  .testi-filter { padding: 1.5rem 1rem 0.8rem; gap: 0.4rem; }\n  .testi-filter-btn { font-size: 0.73rem; padding: 0.38rem 0.8rem; }\n  .testi-grid { grid-template-columns: 1fr; }\n  .testi-grid-section { padding: 1.5rem 1rem 3rem; }\n  .testi-stat { min-width: 100px; padding: 1.2rem 0.5rem; }\n}\n"],"sourceRoot":""}]);

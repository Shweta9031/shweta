nt {\n  display: flex;\n  flex-direction: column;\n  gap: 2rem;\n}\n\n.detail-section {\n  background: #111;\n  border: 1px solid #1e1e1e;\n  border-radius: 12px;\n  padding: 1.5rem;\n}\n\n.detail-section h2 {\n  font-size: 1.1rem;\n  font-weight: 700;\n  color: #FF9933;\n  margin-bottom: 1rem;\n  padding-bottom: 0.5rem;\n  border-bottom: 1px solid #1e1e1e;\n}\n\n.detail-section p {\n  color: #bbb;\n  line-height: 1.8;\n  font-size: 0.95rem;\n}\n\n.detail-work-list {\n  list-style: none;\n  display: flex;\n  flex-direction: column;\n  gap: 0.6rem;\n}\n\n.detail-work-list li {\n  color: #bbb;\n  font-size: 0.92rem;\n  display: flex;\n  align-items: center;\n  gap: 0.6rem;\n}\n\n.detail-yt-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.7rem 1.4rem;\n  border-radius: 8px;\n  color: #fff;\n  font-weight: 600;\n  font-size: 0.9rem;\n  transition: opacity 0.2s, transform 0.2s;\n}\n\n.detail-yt-btn:hover {\n  opacity: 0.85;\n  transform: translateY(-2px);\n}\n\n.detail-nav {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 2.5rem;\n  gap: 1rem;\n}\n\n.detail-nav-btn {\n  padding: 0.6rem 1.2rem;\n  border: 1px solid #2a2a2a;\n  border-radius: 8px;\n  color: #aaa;\n  font-size: 0.88rem;\n  transition: border-color 0.2s, color 0.2s;\n  max-width: 45%;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.detail-nav-btn:hover {\n  border-color: #FF6B00;\n  color: #FF6B00;\n}\n\n.detail-not-found {\n  text-align: center;\n  padding: 6rem 2rem;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 1rem;\n  color: #666;\n}\n\n.detail-not-found span {\n  font-size: 3rem;\n}\n\n.btn-back {\n  padding: 0.6rem 1.4rem;\n  background: #FF6B00;\n  color: #fff;\n  border-radius: 8px;\n  font-weight: 600;\n  font-size: 0.9rem;\n}\n\n@media (max-width: 560px) {\n  .detail-banner-inner {\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n  }\n\n  .detail-im
// Module
___CSS_LOADER_EXPORT___.push([module.id, `.about-page { min-height: 100vh; }

/* â”€â”€ Hero â”€â”€ */
.about-hero {
  position: relative;
  padding: 6rem 2rem 5rem;
  text-align: center;
  background: radial-gradient(ellipse at center, #1a0800 0%, #0a0a0a 70%);
  overflow: hidden;
  border-bottom: 1px solid #2a1200;
}

.about-hero-glow {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 700px; height: 700px;
  background: radial-gradient(circle, rgba(255,107,0,0.12) 0%, transparent 65%);
  pointer-events: none;
}

.about-particle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,107,0,0.15);
  pointer-events: none;
  animation: float 6s ease-in-out infinite;
}
.about-particle-1 { width:12px; height:12px; top:15%; left:10%; animation-delay:0s; }
.about-particle-2 { width:8px;  height:8px;  top:25%; right:15%; animation-delay:1s; }
.about-particle-3 { width:16px; height:16px; top:60%; left:8%;  animation-delay:2s; }
.about-particle-4 { width:10px; height:10px; top:70%; right:10%; animation-delay:0.5s; }
.about-particle-5 { width:6px;  height:6px;  top:40%; left:20%; animation-delay:1.5s; }
.about-particle-6 { width:14px; height:14px; top:80%; right:25%; animation-delay:2.5s; }

@keyframes float {
  0%,100% { transform: translateY(0); opacity:0.6; }
  50% { transform: translateY(-20px); opacity:1; }
}

.about-hero-content {
  position: relative;
  max-width: 700px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.4rem;
}

.about-hero-badge {
  display: inline-block;
  padding: 0.4rem 1.2rem;
  border-radius: 20px;
  background: rgba(255,107,0,0.1);
  border: 1px solid rgba(255,107,0,0.3);
  color: #FF9933;
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.05em;
}

.about-hero-content h1 {
  font-size: clamp(2rem, 5vw, 3.2rem);
  font-weight: 800;
  color: #fff5e6;
  line-height: 1.15;
}

.about-hero-content h1 span {
  background: linear-gradient(135deg, #FF6B00, #FFD700);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.about-hero-content p {
  color: #888;
  line-height: 1.85;
  font-size: 1.05rem;
  max-width: 580px;
}

.about-hero-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 0.5rem;
}

.about-btn-primary {
  padding: 0.8rem 2rem;
  background: linear-gradient(135deg, #FF6B00, #FF9933);
  color: #fff;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.95rem;
  transition: opacity 0.2s, transform 0.2s;
  display: inline-block;
}
.about-btn-primary:hover { opacity: 0.88; transform: translateY(-2px); }

.about-btn-secondary {
  padding: 0.8rem 2rem;
  background: transparent;
  color: #FF6B00;
  border: 1px solid #FF6B00;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.95rem;
  transition: background 0.2s;
  display: inline-block;
}
.about-btn-secondary:hover { background: rgba(255,107,0,0.1); }

/* â”€â”€ Stats Bar â”€â”€ */
.about-stats-bar {
  display: flex;
  justify-content: center;
  background: #0d0d0d;
  border-bottom: 1px solid #111;
}

.about-stats-bar-item {
  flex: 1 1;
  min-width: 130px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.3rem;
  padding: 2rem 1rem;
  border-right: 1px solid #1a1a1a;
  transition: background 0.2s;
}
.about-stats-bar-item:last-child { border-right: none; }
.about-stats-bar-item:hover { background: rgba(255,107,0,0.04); }

.about-stats-icon { font-size: 1.5rem; }

.about-stats-value {
  font-size: 2rem;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00, #FFD700);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
}

.about-stats-label { font-size: 0.8rem; color: #666; text-align: center; }

/* â”€â”€ Section Shared â”€â”€ */
.about-section-tag {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  color: #FF6B00;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 0.5rem;
}

.about-section-header {
  text-align: center;
  margin-bottom: 3rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}

.about-section-header h2 {
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00, #FFD700);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.about-section-header p { color: #777; font-size: 0.95rem; }

/* â”€â”€ Mission â”€â”€ */
.about-mission {
  padding: 5rem 2rem;
  border-bottom: 1px solid #111;
}

.about-mission-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}

/* Image Side */
.about-mission-img-side {
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
}

.about-mission-img-wrap {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid #2a1200;
  aspect-ratio: 4/5;
}

.about-mission-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
}

.about-mission-img-glow {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 50%);
  pointer-events: none;
}

.about-mission-img-badge {
  position: absolute;
  bottom: 1.2rem;
  left: 1.2rem;
  background: rgba(10,10,10,0.85);
  border: 1px solid #2a1200;
  backdrop-filter: blur(8px);
  border-radius: 10px;
  padding: 0.6rem 1rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.about-mission-img-badge span { font-size: 1.4rem; }

.about-mission-img-badge p {
  font-size: 0.82rem;
  font-weight: 600;
  color: #FFD700;
  margin: 0;
}

.about-mission-img-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.8rem;
}

.about-mission-mini-card {
  background: #111;
  border: 1px solid #1a1a1a;
  border-radius: 12px;
  padding: 1rem;
  display: flex;
  align-items: center;
  gap: 0.7rem;
  transition: border-color 0.2s;
}
.about-mission-mini-card:hover { border-color: #FF6B00; }

.about-mission-mini-card span { font-size: 1.5rem; }

.about-mission-mini-card strong {
  display: block;
  font-size: 1.1rem;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00, #FFD700);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.about-mission-mini-card p {
  font-size: 0.72rem;
  color: #666;
  margin: 0;
}

/* Text Side */
.about-mission-text { display: flex; flex-direction: column; gap: 1rem; }

.about-mission-text h2 {
  font-size: clamp(1.5rem, 2.5vw, 2rem);
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00, #FFD700);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1.3;
}

.about-mission-text p { color: #888; line-height: 1.85; font-size: 0.95rem; }

.about-mission-points {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  margin-top: 0.5rem;
}

.about-mission-point {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  font-size: 0.88rem;
  color: #bbb;
}

.about-point-check {
  width: 20px; height: 20px;
  border-radius: 50%;
  background: rgba(255,107,0,0.15);
  border: 1px solid rgba(255,107,0,0.3);
  color: #FF6B00;
  font-size: 0.7rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* â”€â”€ Values â”€â”€ */
.about-values {
  padding: 5rem 2rem;
  background: #0a0a0a;
  border-bottom: 1px solid #111;
}

.about-values-inner { max-width: 1200px; margin: 0 auto; }

.values-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.value-card {
  background: #111;
  border: 1px solid #1a1a1a;
  border-radius: 16px;
  padding: 2rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
  transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
}
.value-card:hover {
  border-color: #FF6B00;
  transform: translateY(-4px);
  box-shadow: 0 8px 30px rgba(255,107,0,0.1);
}

.value-icon-wrap {
  width: 52px; height: 52px;
  border-radius: 12px;
  background: rgba(255,107,0,0.1);
  border: 1px solid rgba(255,107,0,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.value-icon { font-size: 1.6rem; }

.value-card h3 { font-size: 1rem; font-weight: 700; color: #FF9933; }
.value-card p { font-size: 0.85rem; color: #777; line-height: 1.7; }

/* â”€â”€ Timeline â”€â”€ */
.about-timeline {
  padding: 5rem 2rem;
  border-bottom: 1px solid #111;
}

.about-timeline-inner { max-width: 800px; margin: 0 auto; }

.timeline-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  position: relative;
  padding-left: 2rem;
}

.timeline-list::before {
  content: '';
  position: absolute;
  left: 0.45rem;
  top: 0.5rem;
  bottom: 0.5rem;
  width: 2px;
  background: linear-gradient(to bottom, #FF6B00, #2a1200);
  border-radius: 2px;
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 80px 1fr;
  gap: 1.5rem;
  padding-bottom: 2.5rem;
  align-items: start;
}
.timeline-item:last-child { padding-bottom: 0; }

.timeline-dot {
  position: absolute;
  left: -1.65rem;
  top: 0.3rem;
  width: 14px; height: 14px;
  border-radius: 50%;
  background: #FF6B00;
  border: 3px solid #0a0a0a;
  box-shadow: 0 0 0 2px #FF6B00;
}

.timeline-year {
  font-size: 0.82rem;
  font-weight: 700;
  color: #FF6B00;
  background: rgba(255,107,0,0.1);
  border: 1px solid rgba(255,107,0,0.2);
  border-radius: 6px;
  padding: 0.3rem 0.6rem;
  text-align: center;
  height: fit-content;
}

.timeline-content {
  background: #111;
  border: 1px solid #1a1a1a;
  border-radius: 12px;
  padding: 1.2rem 1.4rem;
  transition: border-color 0.2s;
}
.timeline-content:hover { border-color: #FF6B00; }

.timeline-content h3 { font-size: 0.95rem; font-weight: 700; color: #fff5e6; margin-bottom: 0.4rem; }
.timeline-content p { font-size: 0.85rem; color: #777; line-height: 1.65; }

/* â”€â”€ Team â”€â”€ */
.about-team {
  padding: 5rem 2rem;
  background: #0a0a0a;
  border-bottom: 1px solid #111;
}

.about-team-inner { max-width: 900px; margin: 0 auto; }

.team-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.team-card {
  background: #111;
  border: 1px solid #1a1a1a;
  border-radius: 16px;
  padding: 2.5rem 1.5rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.8rem;
  transition: border-color 0.2s, transform 0.2s;
}
.team-card:hover { border-color: #FF6B00; transform: translateY(-4px); }

.team-icon {
  font-size: 2.5rem;
  width: 70px; height: 70px;
  border-radius: 50%;
  background: rgba(255,107,0,0.1);
  border: 2px solid rgba(255,107,0,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.team-card h3 { font-size: 1rem; font-weight: 700; color: #fff5e6; }
.team-card p { font-size: 0.82rem; color: #FF9933; font-weight: 500; }

/* â”€â”€ Quote â”€â”€ */
.about-quote {
  padding: 5rem 2rem;
  background: linear-gradient(135deg, #1a0800, #0a0a0a);
  border-bottom: 1px solid #2a1200;
  text-align: center;
}

.about-quote-inner {
  max-width: 700px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}

.about-quote-mark {
  font-size: 5rem;
  line-height: 0.5;
  color: #FF6B00;
  opacity: 0.4;
  font-family: Georgia, serif;
}

.about-quote-inner blockquote {
  font-size: 1.2rem;
  color: #FFD700;
  font-style: italic;
  line-height: 1.9;
}

.about-quote-inner cite { font-size: 0.85rem; color: #555; font-style: normal; }

.about-quote-translation {
  font-size: 0.88rem;
  color: #666;
  line-height: 1.7;
  font-style: italic;
  max-width: 560px;
}

/* â”€â”€ CTA â”€â”€ */
.about-cta {
  position: relative;
  padding: 6rem 2rem;
  text-align: center;
  background: radial-gradient(ellipse at center, #1a0800 0%, #0a0a0a 70%);
  overflow: hidden;
}

.about-cta-glow {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 600px; height: 400px;
  background: radial-gradient(circle, rgba(255,107,0,0.1) 0%, transparent 70%);
  pointer-events: none;
}

.about-cta-inner {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.2rem;
}

.about-cta-om { font-size: 3rem; }

.about-cta-inner h2 {
  font-size: clamp(1.8rem, 3.5vw, 2.5rem);
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00, #FFD700);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.about-cta-inner p { color: #777; font-size: 1rem; max-width: 500px; line-height: 1.7; }

.about-cta-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 0.5rem;
}

/* â”€â”€ Responsive â”€â”€ */
@media (max-width: 1024px) {
  .values-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 900px) {
  .about-mission-inner { grid-template-columns: 1fr; gap: 2.5rem; }
  .about-mission-img-wrap { aspect-ratio: 16/9; }
  .team-grid { grid-template-columns: 1fr; max-width: 400px; margin: 0 auto; }
}

@media (max-width: 600px) {
  .about-stats-bar { flex-wrap: wrap; }
  .about-stats-bar-item { flex: 0 0 50%; border-bottom: 1px solid #1a1a1a; }
  .values-grid { grid-template-columns: 1fr; }
  .about-mission-visual { grid-template-columns: 1fr; }
  .timeline-item { grid-template-columns: 60px 1fr; gap: 1rem; }
  .about-hero { padding: 4rem 1.5rem 3rem; }
}
`, "",{"version":3,"sources":["webpack://./src/pages/About.css"],"names":[],"mappings":"AAAA,cAAc,iBAAiB,EAAE;;AAEjC,uBAAuB;AACvB;EACE,kBAAkB;EAClB,uBAAuB;EACvB,kBAAkB;EAClB,uEAAuE;EACvE,gBAAgB;EAChB,gCAAgC;AAClC;;AAEA;EACE,kBAAkB;EAClB,QAAQ,EAAE,SAAS;EACnB,gCAAgC;EAChC,YAAY,EAAE,aAAa;EAC3B,6EAA6E;EAC7E,oBAAoB;AACtB;;AAEA;EACE,kBAAkB;EAClB,kBAAkB;EAClB,gCAAgC;EAChC,oBAAoB;EACpB,wCAAwC;AAC1C;AACA,oBAAoB,UAAU,EAAE,WAAW,EAAE,OAAO,EAAE,QAAQ,EAAE,kBAAkB,EAAE;AACpF,oBAAoB,SAAS,GAAG,UAAU,GAAG,OAAO,EAAE,SAAS,EAAE,kBAAkB,EAAE;AACrF,oBAAoB,UAAU,EAAE,WAAW,EAAE,OAAO,EAAE,OAAO,GAAG,kBAAkB,EAAE;AACpF,oBAAoB,UAAU,EAAE,WAAW,EAAE,OAAO,EAAE,SAAS,EAAE,oBAAoB,EAAE;AACvF,oBAAoB,SAAS,GAAG,UAAU,GAAG,OAAO,EAAE,QAAQ,EAAE,oBAAoB,EAAE;AACtF,oBAAoB,UAAU,EAAE,WAAW,EAAE,OAAO,EAAE,SAAS,EAAE,oBAAoB,EAAE;;AAEvF;EACE,UAAU,wBAAwB,EAAE,WAAW,EAAE;EACjD,MAAM,4BAA4B,EAAE,SAAS,EAAE;AACjD;;AAEA;EACE,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;EACd,aAAa;EACb,sBAAsB;EACtB,mBAAmB;EACnB,WAAW;AACb;;AAEA;EACE,qBAAqB;EACrB,sBAAsB;EACtB,mBAAmB;EACnB,+BAA+B;EAC/B,qCAAqC;EACrC,cAAc;EACd,kBAAkB;EAClB,gBAAgB;EAChB,sBAAsB;AACxB;;AAEA;EACE,mCAAmC;EACnC,gBAAgB;EAChB,cAAc;EACd,iBAAiB;AACnB;;AAEA;EACE,qDAAqD;EACrD,6BAA6B;EAC7B,oCAAoC;EACpC,qBAAqB;AACvB;;AAEA;EACE,WAAW;EACX,iBAAiB;EACjB,kBAAkB;EAClB,gBAAgB;AAClB;;AAEA;EACE,aAAa;EACb,SAAS;EACT,eAAe;EACf,uBAAuB;EACvB,kBAAkB;AACpB;;AAEA;EACE,oBAAoB;EACpB,qDAAqD;EACrD,WAAW;EACX,kBAAkB;EAClB,gBAAgB;EAChB,kBAAkB;EAClB,wCAAwC;EACxC,qBAAqB;AACvB;AACA,2BAA2B,aAAa,EAAE,2BAA2B,EAAE;;AAEvE;EACE,oBAAoB;EACpB,uBAAuB;EACvB,cAAc;EACd,yBAAyB;EACzB,kBAAkB;EAClB,gBAAgB;EAChB,kBAAkB;EAClB,2BAA2B;EAC3B,qBAAqB;AACvB;AACA,6BAA6B,+BAA+B,EAAE;;AAE9D,4BAA4B;AAC5B;EACE,aAAa;EACb,uBAAuB;EACvB,mBAAmB;EACnB,6BAA6B;AAC/B;;AAEA;EACE,SAAO;EACP,gBAAgB;EAChB,aAAa;EACb,sBAAsB;EACtB,mBAAmB;EACnB,WAAW;EACX,kBAAkB;EAClB,+BAA+B;EAC/B,2BAA2B;AAC7B;AACA,mCAAmC,kBAAkB,EAAE;AACvD,8BAA8B,gCAAgC,EAAE;;AAEhE,oBAAoB,iBAAiB,EAAE;;AAEvC;EACE,eAAe;EACf,gBAAgB;EAChB,qDAAqD;EACrD,6BAA6B;EAC7B,oCAAoC;EACpC,qBAAqB;EACrB,cAAc;AAChB;;AAEA,qBAAqB,iBAAiB,EAAE,WAAW,EAAE,kBAAkB,EAAE;;AAEzE,iCAAiC;AACjC;EACE,qBAAqB;EACrB,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;EACd,yBAAyB;EACzB,qBAAqB;EACrB,qBAAqB;AACvB;;AAEA;EACE,kBAAkB;EAClB,mBAAmB;EACnB,aAAa;EACb,sBAAsB;EACtB,mBAAmB;EACnB,WAAW;AACb;;AAEA;EACE,qCAAqC;EACrC,gBAAgB;EAChB,qDAAqD;EACrD,6BAA6B;EAC7B,oCAAoC;EACpC,qBAAqB;AACvB;;AAEA,0BAA0B,WAAW,EAAE,kBAAkB,EAAE;;AAE3D,0BAA0B;AAC1B;EACE,kBAAkB;EAClB,6BAA6B;AAC/B;;AAEA;EACE,iBAAiB;EACjB,cAAc;EACd,aAAa;EACb,8BAA8B;EAC9B,SAAS;EACT,mBAAmB;AACrB;;AAEA,eAAe;AACf;EACE,aAAa;EACb,sBAAsB;EACtB,WAAW;AACb;;AAEA;EACE,kBAAkB;EAClB,mBAAmB;EACnB,gBAAgB;EAChB,yBAAyB;EACzB,iBAAiB;AACnB;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,iBAAiB;EACjB,2BAA2B;EAC3B,cAAc;AAChB;;AAEA;EACE,kBAAkB;EAClB,QAAQ;EACR,wEAAwE;EACxE,oBAAoB;AACtB;;AAEA;EACE,kBAAkB;EAClB,cAAc;EACd,YAAY;EACZ,+BAA+B;EAC/B,yBAAyB;EACzB,0BAA0B;EAC1B,mBAAmB;EACnB,oBAAoB;EACpB,aAAa;EACb,mBAAmB;EACnB,WAAW;AACb;;AAEA,gCAAgC,iBAAiB,EAAE;;AAEnD;EACE,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;EACd,SAAS;AACX;;AAEA;EACE,aAAa;EACb,8BAA8B;EAC9B,WAAW;AACb;;AAEA;EACE,gBAAgB;EAChB,yBAAyB;EACzB,mBAAmB;EACnB,aAAa;EACb,aAAa;EACb,mBAAmB;EACnB,WAAW;EACX,6BAA6B;AAC/B;AACA,iCAAiC,qBAAqB,EAAE;;AAExD,gCAAgC,iBAAiB,EAAE;;AAEnD;EACE,cAAc;EACd,iBAAiB;EACjB,gBAAgB;EAChB,qDAAqD;EACrD,6BAA6B;EAC7B,oCAAoC;EACpC,qBAAqB;AACvB;;AAEA;EACE,kBAAkB;EAClB,WAAW;EACX,SAAS;AACX;;AAEA,cAAc;AACd,sBAAsB,aAAa,EAAE,sBAAsB,EAAE,SAAS,EAAE;;AAExE;EACE,qCAAqC;EACrC,gBAAgB;EAChB,qDAAqD;EACrD,6BAA6B;EAC7B,oCAAoC;EACpC,qBAAqB;EACrB,gBAAgB;AAClB;;AAEA,wBAAwB,WAAW,EAAE,iBAAiB,EAAE,kBAAkB,EAAE;;AAE5E;EACE,aAAa;EACb,sBAAsB;EACtB,WAAW;EACX,kBAAkB;AACpB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,WAAW;EACX,kBAAkB;EAClB,WAAW;AACb;;AAEA;EACE,WAAW,EAAE,YAAY;EACzB,kBAAkB;EAClB,gCAAgC;EAChC,qCAAqC;EACrC,cAAc;EACd,iBAAiB;EACjB,gBAAgB;EAChB,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,cAAc;AAChB;;AAEA,yBAAyB;AACzB;EACE,kBAAkB;EAClB,mBAAmB;EACnB,6BAA6B;AAC/B;;AAEA,sBAAsB,iBAAiB,EAAE,cAAc,EAAE;;AAEzD;EACE,aAAa;EACb,qCAAqC;EACrC,WAAW;AACb;;AAEA;EACE,gBAAgB;EAChB,yBAAyB;EACzB,mBAAmB;EACnB,oBAAoB;EACpB,aAAa;EACb,sBAAsB;EACtB,WAAW;EACX,8DAA8D;AAChE;AACA;EACE,qBAAqB;EACrB,2BAA2B;EAC3B,0CAA0C;AAC5C;;AAEA;EACE,WAAW,EAAE,YAAY;EACzB,mBAAmB;EACnB,+BAA+B;EAC/B,qCAAqC;EACrC,aAAa;EACb,mBAAmB;EACnB,uBAAuB;AACzB;;AAEA,cAAc,iBAAiB,EAAE;;AAEjC,iBAAiB,eAAe,EAAE,gBAAgB,EAAE,cAAc,EAAE;AACpE,gBAAgB,kBAAkB,EAAE,WAAW,EAAE,gBAAgB,EAAE;;AAEnE,2BAA2B;AAC3B;EACE,kBAAkB;EAClB,6BAA6B;AAC/B;;AAEA,wBAAwB,gBAAgB,EAAE,cAAc,EAAE;;AAE1D;EACE,aAAa;EACb,sBAAsB;EACtB,MAAM;EACN,kBAAkB;EAClB,kBAAkB;AACpB;;AAEA;EACE,WAAW;EACX,kBAAkB;EAClB,aAAa;EACb,WAAW;EACX,cAAc;EACd,UAAU;EACV,wDAAwD;EACxD,kBAAkB;AACpB;;AAEA;EACE,kBAAkB;EAClB,aAAa;EACb,+BAA+B;EAC/B,WAAW;EACX,sBAAsB;EACtB,kBAAkB;AACpB;AACA,4BAA4B,iBAAiB,EAAE;;AAE/C;EACE,kBAAkB;EAClB,cAAc;EACd,WAAW;EACX,WAAW,EAAE,YAAY;EACzB,kBAAkB;EAClB,mBAAmB;EACnB,yBAAyB;EACzB,6BAA6B;AAC/B;;AAEA;EACE,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;EACd,+BAA+B;EAC/B,qCAAqC;EACrC,kBAAkB;EAClB,sBAAsB;EACtB,kBAAkB;EAClB,mBAAmB;AACrB;;AAEA;EACE,gBAAgB;EAChB,yBAAyB;EACzB,mBAAmB;EACnB,sBAAsB;EACtB,6BAA6B;AAC/B;AACA,0BAA0B,qBAAqB,EAAE;;AAEjD,uBAAuB,kBAAkB,EAAE,gBAAgB,EAAE,cAAc,EAAE,qBAAqB,EAAE;AACpG,sBAAsB,kBAAkB,EAAE,WAAW,EAAE,iBAAiB,EAAE;;AAE1E,uBAAuB;AACvB;EACE,kBAAkB;EAClB,mBAAmB;EACnB,6BAA6B;AAC/B;;AAEA,oBAAoB,gBAAgB,EAAE,cAAc,EAAE;;AAEtD;EACE,aAAa;EACb,qCAAqC;EACrC,WAAW;AACb;;AAEA;EACE,gBAAgB;EAChB,yBAAyB;EACzB,mBAAmB;EACnB,sBAAsB;EACtB,kBAAkB;EAClB,aAAa;EACb,sBAAsB;EACtB,mBAAmB;EACnB,WAAW;EACX,6CAA6C;AAC/C;AACA,mBAAmB,qBAAqB,EAAE,2BAA2B,EAAE;;AAEvE;EACE,iBAAiB;EACjB,WAAW,EAAE,YAAY;EACzB,kBAAkB;EAClB,+BAA+B;EAC/B,qCAAqC;EACrC,aAAa;EACb,mBAAmB;EACnB,uBAAuB;AACzB;;AAEA,gBAAgB,eAAe,EAAE,gBAAgB,EAAE,cAAc,EAAE;AACnE,eAAe,kBAAkB,EAAE,cAAc,EAAE,gBAAgB,EAAE;;AAErE,wBAAwB;AACxB;EACE,kBAAkB;EAClB,qDAAqD;EACrD,gCAAgC;EAChC,kBAAkB;AACpB;;AAEA;EACE,gBAAgB;EAChB,cAAc;EACd,aAAa;EACb,sBAAsB;EACtB,mBAAmB;EACnB,SAAS;AACX;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,cAAc;EACd,YAAY;EACZ,2BAA2B;AAC7B;;AAEA;EACE,iBAAiB;EACjB,cAAc;EACd,kBAAkB;EAClB,gBAAgB;AAClB;;AAEA,0BAA0B,kBAAkB,EAAE,WAAW,EAAE,kBAAkB,EAAE;;AAE/E;EACE,kBAAkB;EAClB,WAAW;EACX,gBAAgB;EAChB,kBAAkB;EAClB,gBAAgB;AAClB;;AAEA,sBAAsB;AACtB;EACE,kBAAkB;EAClB,kBAAkB;EAClB,kBAAkB;EAClB,uEAAuE;EACvE,gBAAgB;AAClB;;AAEA;EACE,kBAAkB;EAClB,QAAQ,EAAE,SAAS;EACnB,gCAAgC;EAChC,YAAY,EAAE,aAAa;EAC3B,4EAA4E;EAC5E,oBAAoB;AACtB;;AAEA;EACE,kBAAkB;EAClB,aAAa;EACb,sBAAsB;EACtB,mBAAmB;EACnB,WAAW;AACb;;AAEA,gBAAgB,eAAe,EAAE;;AAEjC;EACE,uCAAuC;EACvC,gBAAgB;EAChB,qDAAqD;EACrD,6BAA6B;EAC7B,oCAAoC;EACpC,qBAAqB;AACvB;;AAEA,qBAAqB,WAAW,EAAE,eAAe,EAAE,gBAAgB,EAAE,gBAAgB,EAAE;;AAEvF;EACE,aAAa;EACb,SAAS;EACT,eAAe;EACf,uBAAuB;EACvB,kBAAkB;AACpB;;AAEA,6BAA6B;AAC7B;EACE,eAAe,qCAAqC,EAAE;AACxD;;AAEA;EACE,uBAAuB,0BAA0B,EAAE,WAAW,EAAE;EAChE,0BAA0B,kBAAkB,EAAE;EAC9C,aAAa,0BAA0B,EAAE,gBAAgB,EAAE,cAAc,EAAE;AAC7E;;AAEA;EACE,mBAAmB,eAAe,EAAE;EACpC,wBAAwB,aAAa,EAAE,gCAAgC,EAAE;EACzE,eAAe,0BAA0B,EAAE;EAC3C,wBAAwB,0BAA0B,EAAE;EACpD,iBAAiB,+BAA+B,EAAE,SAAS,EAAE;EAC7D,cAAc,yBAAyB,EAAE;AAC3C","sourcesContent":[".about-page { min-height: 100vh; }\n\n/* â”€â”€ Hero â”€â”€ */\n.about-hero {\n  position: relative;\n  padding: 6rem 2rem 5rem;\n  text-align: center;\n  background: radial-gradient(ellipse at center, #1a0800 0%, #0a0a0a 70%);\n  overflow: hidden;\n  border-bottom: 1px solid #2a1200;\n}\n\n.about-hero-glow {\n  position: absolute;\n  top: 50%; left: 50%;\n  transform: translate(-50%, -50%);\n  width: 700px; height: 700px;\n  background: radial-gradient(circle, rgba(255,107,0,0.12) 0%, transparent 65%);\n  pointer-events: none;\n}\n\n.about-particle {\n  position: absolute;\n  border-radius: 50%;\n  background: rgba(255,107,0,0.15);\n  pointer-events: none;\n  animation: float 6s ease-in-out infinite;\n}\n.about-particle-1 { width:12px; height:12px; top:15%; left:10%; animation-delay:0s; }\n.about-particle-2 { width:8px;  height:8px;  top:25%; right:15%; animation-delay:1s; }\n.about-particle-3 { width:16px; height:16px; top:60%; left:8%;  animation-delay:2s; }\n.about-particle-4 { width:10px; height:10px; top:70%; right:10%; animation-delay:0.5s; }\n.about-particle-5 { width:6px;  height:6px;  top:40%; left:20%; animation-delay:1.5s; }\n.about-particle-6 { width:14px; height:14px; top:80%; right:25%; animation-delay:2.5s; }\n\n@keyframes float {\n  0%,100% { transform: translateY(0); opacity:0.6; }\n  50% { transform: translateY(-20px); opacity:1; }\n}\n\n.about-hero-content {\n  position: relative;\n  max-width: 700px;\n  margin: 0 auto;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 1.4rem;\n}\n\n.about-hero-badge {\n  display: inline-block;\n  padding: 0.4rem 1.2rem;\n  border-radius: 20px;\n  background: rgba(255,107,0,0.1);\n  border: 1px solid rgba(255,107,0,0.3);\n  color: #FF9933;\n  font-size: 0.82rem;\n  font-weight: 600;\n  letter-spacing: 0.05em;\n}\n\n.about-hero-content h1 {\n  font-size: clamp(2rem, 5vw, 3.2rem);\n  font-weight: 800;\n  color: #fff5e6;\n  line-height: 1.15;\n}\n\n.about-hero-content h1 span {\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n.about-hero-content p {\n  color: #888;\n  line-height: 1.85;\n  font-size: 1.05rem;\n  max-width: 580px;\n}\n\n.about-hero-actions {\n  display: flex;\n  gap: 1rem;\n  flex-wrap: wrap;\n  justify-content: center;\n  margin-top: 0.5rem;\n}\n\n.about-btn-primary {\n  padding: 0.8rem 2rem;\n  background: linear-gradient(135deg, #FF6B00, #FF9933);\n  color: #fff;\n  border-radius: 8px;\n  font-weight: 600;\n  font-size: 0.95rem;\n  transition: opacity 0.2s, transform 0.2s;\n  display: inline-block;\n}\n.about-btn-primary:hover { opacity: 0.88; transform: translateY(-2px); }\n\n.about-btn-secondary {\n  padding: 0.8rem 2rem;\n  background: transparent;\n  color: #FF6B00;\n  border: 1px solid #FF6B00;\n  border-radius: 8px;\n  font-weight: 600;\n  font-size: 0.95rem;\n  transition: background 0.2s;\n  display: inline-block;\n}\n.about-btn-secondary:hover { background: rgba(255,107,0,0.1); }\n\n/* â”€â”€ Stats Bar â”€â”€ */\n.about-stats-bar {\n  display: flex;\n  justify-content: center;\n  background: #0d0d0d;\n  border-bottom: 1px solid #111;\n}\n\n.about-stats-bar-item {\n  flex: 1;\n  min-width: 130px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.3rem;\n  padding: 2rem 1rem;\n  border-right: 1px solid #1a1a1a;\n  transition: background 0.2s;\n}\n.about-stats-bar-item:last-child { border-right: none; }\n.about-stats-bar-item:hover { background: rgba(255,107,0,0.04); }\n\n.about-stats-icon { font-size: 1.5rem; }\n\n.about-stats-value {\n  font-size: 2rem;\n  font-weight: 800;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  line-height: 1;\n}\n\n.about-stats-label { font-size: 0.8rem; color: #666; text-align: center; }\n\n/* â”€â”€ Section Shared â”€â”€ */\n.about-section-tag {\n  display: inline-block;\n  font-size: 0.75rem;\n  font-weight: 700;\n  color: #FF6B00;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  margin-bottom: 0.5rem;\n}\n\n.about-section-header {\n  text-align: center;\n  margin-bottom: 3rem;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.about-section-header h2 {\n  font-size: clamp(1.6rem, 3vw, 2.2rem);\n  font-weight: 800;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n.about-section-header p { color: #777; font-size: 0.95rem; }\n\n/* â”€â”€ Mission â”€â”€ */\n.about-mission {\n  padding: 5rem 2rem;\n  border-bottom: 1px solid #111;\n}\n\n.about-mission-inner {\n  max-width: 1200px;\n  margin: 0 auto;\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 4rem;\n  align-items: center;\n}\n\n/* Image Side */\n.about-mission-img-side {\n  display: flex;\n  flex-direction: column;\n  gap: 1.2rem;\n}\n\n.about-mission-img-wrap {\n  position: relative;\n  border-radius: 20px;\n  overflow: hidden;\n  border: 1px solid #2a1200;\n  aspect-ratio: 4/5;\n}\n\n.about-mission-img-wrap img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: top center;\n  display: block;\n}\n\n.about-mission-img-glow {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 50%);\n  pointer-events: none;\n}\n\n.about-mission-img-badge {\n  position: absolute;\n  bottom: 1.2rem;\n  left: 1.2rem;\n  background: rgba(10,10,10,0.85);\n  border: 1px solid #2a1200;\n  backdrop-filter: blur(8px);\n  border-radius: 10px;\n  padding: 0.6rem 1rem;\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.about-mission-img-badge span { font-size: 1.4rem; }\n\n.about-mission-img-badge p {\n  font-size: 0.82rem;\n  font-weight: 600;\n  color: #FFD700;\n  margin: 0;\n}\n\n.about-mission-img-cards {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 0.8rem;\n}\n\n.about-mission-mini-card {\n  background: #111;\n  border: 1px solid #1a1a1a;\n  border-radius: 12px;\n  padding: 1rem;\n  display: flex;\n  align-items: center;\n  gap: 0.7rem;\n  transition: border-color 0.2s;\n}\n.about-mission-mini-card:hover { border-color: #FF6B00; }\n\n.about-mission-mini-card span { font-size: 1.5rem; }\n\n.about-mission-mini-card strong {\n  display: block;\n  font-size: 1.1rem;\n  font-weight: 800;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n.about-mission-mini-card p {\n  font-size: 0.72rem;\n  color: #666;\n  margin: 0;\n}\n\n/* Text Side */\n.about-mission-text { display: flex; flex-direction: column; gap: 1rem; }\n\n.about-mission-text h2 {\n  font-size: clamp(1.5rem, 2.5vw, 2rem);\n  font-weight: 800;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  line-height: 1.3;\n}\n\n.about-mission-text p { color: #888; line-height: 1.85; font-size: 0.95rem; }\n\n.about-mission-points {\n  display: flex;\n  flex-direction: column;\n  gap: 0.6rem;\n  margin-top: 0.5rem;\n}\n\n.about-mission-point {\n  display: flex;\n  align-items: center;\n  gap: 0.7rem;\n  font-size: 0.88rem;\n  color: #bbb;\n}\n\n.about-point-check {\n  width: 20px; height: 20px;\n  border-radius: 50%;\n  background: rgba(255,107,0,0.15);\n  border: 1px solid rgba(255,107,0,0.3);\n  color: #FF6B00;\n  font-size: 0.7rem;\n  font-weight: 700;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n/* â”€â”€ Values â”€â”€ */\n.about-values {\n  padding: 5rem 2rem;\n  background: #0a0a0a;\n  border-bottom: 1px solid #111;\n}\n\n.about-values-inner { max-width: 1200px; margin: 0 auto; }\n\n.values-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 1.5rem;\n}\n\n.value-card {\n  background: #111;\n  border: 1px solid #1a1a1a;\n  border-radius: 16px;\n  padding: 2rem 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.7rem;\n  transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;\n}\n.value-card:hover {\n  border-color: #FF6B00;\n  transform: translateY(-4px);\n  box-shadow: 0 8px 30px rgba(255,107,0,0.1);\n}\n\n.value-icon-wrap {\n  width: 52px; height: 52px;\n  border-radius: 12px;\n  background: rgba(255,107,0,0.1);\n  border: 1px solid rgba(255,107,0,0.2);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.value-icon { font-size: 1.6rem; }\n\n.value-card h3 { font-size: 1rem; font-weight: 700; color: #FF9933; }\n.value-card p { font-size: 0.85rem; color: #777; line-height: 1.7; }\n\n/* â”€â”€ Timeline â”€â”€ */\n.about-timeline {\n  padding: 5rem 2rem;\n  border-bottom: 1px solid #111;\n}\n\n.about-timeline-inner { max-width: 800px; margin: 0 auto; }\n\n.timeline-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0;\n  position: relative;\n  padding-left: 2rem;\n}\n\n.timeline-list::before {\n  content: '';\n  position: absolute;\n  left: 0.45rem;\n  top: 0.5rem;\n  bottom: 0.5rem;\n  width: 2px;\n  background: linear-gradient(to bottom, #FF6B00, #2a1200);\n  border-radius: 2px;\n}\n\n.timeline-item {\n  position: relative;\n  display: grid;\n  grid-template-columns: 80px 1fr;\n  gap: 1.5rem;\n  padding-bottom: 2.5rem;\n  align-items: start;\n}\n.timeline-item:last-child { padding-bottom: 0; }\n\n.timeline-dot {\n  position: absolute;\n  left: -1.65rem;\n  top: 0.3rem;\n  width: 14px; height: 14px;\n  border-radius: 50%;\n  background: #FF6B00;\n  border: 3px solid #0a0a0a;\n  box-shadow: 0 0 0 2px #FF6B00;\n}\n\n.timeline-year {\n  font-size: 0.82rem;\n  font-weight: 700;\n  color: #FF6B00;\n  background: rgba(255,107,0,0.1);\n  border: 1px solid rgba(255,107,0,0.2);\n  border-radius: 6px;\n  padding: 0.3rem 0.6rem;\n  text-align: center;\n  height: fit-content;\n}\n\n.timeline-content {\n  background: #111;\n  border: 1px solid #1a1a1a;\n  border-radius: 12px;\n  padding: 1.2rem 1.4rem;\n  transition: border-color 0.2s;\n}\n.timeline-content:hover { border-color: #FF6B00; }\n\n.timeline-content h3 { font-size: 0.95rem; font-weight: 700; color: #fff5e6; margin-bottom: 0.4rem; }\n.timeline-content p { font-size: 0.85rem; color: #777; line-height: 1.65; }\n\n/* â”€â”€ Team â”€â”€ */\n.about-team {\n  padding: 5rem 2rem;\n  background: #0a0a0a;\n  border-bottom: 1px solid #111;\n}\n\n.about-team-inner { max-width: 900px; margin: 0 auto; }\n\n.team-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 1.5rem;\n}\n\n.team-card {\n  background: #111;\n  border: 1px solid #1a1a1a;\n  border-radius: 16px;\n  padding: 2.5rem 1.5rem;\n  text-align: center;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.8rem;\n  transition: border-color 0.2s, transform 0.2s;\n}\n.team-card:hover { border-color: #FF6B00; transform: translateY(-4px); }\n\n.team-icon {\n  font-size: 2.5rem;\n  width: 70px; height: 70px;\n  border-radius: 50%;\n  background: rgba(255,107,0,0.1);\n  border: 2px solid rgba(255,107,0,0.2);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.team-card h3 { font-size: 1rem; font-weight: 700; color: #fff5e6; }\n.team-card p { font-size: 0.82rem; color: #FF9933; font-weight: 500; }\n\n/* â”€â”€ Quote â”€â”€ */\n.about-quote {\n  padding: 5rem 2rem;\n  background: linear-gradient(135deg, #1a0800, #0a0a0a);\n  border-bottom: 1px solid #2a1200;\n  text-align: center;\n}\n\n.about-quote-inner {\n  max-width: 700px;\n  margin: 0 auto;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 1rem;\n}\n\n.about-quote-mark {\n  font-size: 5rem;\n  line-height: 0.5;\n  color: #FF6B00;\n  opacity: 0.4;\n  font-family: Georgia, serif;\n}\n\n.about-quote-inner blockquote {\n  font-size: 1.2rem;\n  color: #FFD700;\n  font-style: italic;\n  line-height: 1.9;\n}\n\n.about-quote-inner cite { font-size: 0.85rem; color: #555; font-style: normal; }\n\n.about-quote-translation {\n  font-size: 0.88rem;\n  color: #666;\n  line-height: 1.7;\n  font-style: italic;\n  max-width: 560px;\n}\n\n/* â”€â”€ CTA â”€â”€ */\n.about-cta {\n  position: relative;\n  padding: 6rem 2rem;\n  text-align: center;\n  background: radial-gradient(ellipse at center, #1a0800 0%, #0a0a0a 70%);\n  overflow: hidden;\n}\n\n.about-cta-glow {\n  position: absolute;\n  top: 50%; left: 50%;\n  transform: translate(-50%, -50%);\n  width: 600px; height: 400px;\n  background: radial-gradient(circle, rgba(255,107,0,0.1) 0%, transparent 70%);\n  pointer-events: none;\n}\n\n.about-cta-inner {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 1.2rem;\n}\n\n.about-cta-om { font-size: 3rem; }\n\n.about-cta-inner h2 {\n  font-size: clamp(1.8rem, 3.5vw, 2.5rem);\n  font-weight: 800;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n.about-cta-inner p { color: #777; font-size: 1rem; max-width: 500px; line-height: 1.7; }\n\n.about-cta-actions {\n  display: flex;\n  gap: 1rem;\n  flex-wrap: wrap;\n  justify-content: center;\n  margin-top: 0.5rem;\n}\n\n/* â”€â”€ Responsive â”€â”€ */\n@media (max-width: 1024px) {\n  .values-grid { grid-template-columns: repeat(2, 1fr); }\n}\n\n@media (max-width: 900px) {\n  .about-mission-inner { grid-template-columns: 1fr; gap: 2.5rem; }\n  .about-mission-img-wrap { aspect-ratio: 16/9; }\n  .team-grid { grid-template-columns: 1fr; max-width: 400px; margin: 0 auto; }\n}\n\n@media (max-width: 600px) {\n  .about-stats-bar { flex-wrap: wrap; }\n  .about-stats-bar-item { flex: 0 0 50%; border-bottom: 1px solid #1a1a1a; }\n  .values-grid { grid-template-columns: 1fr; }\n  .about-mission-visual { grid-template-columns: 1fr; }\n  .timeline-item { grid-template-columns: 60px 1fr; gap: 1rem; }\n  .about-hero { padding: 4rem 1.5rem 3rem; }\n}\n"],"sourceRoot":""}]);

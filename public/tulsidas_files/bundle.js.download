AAEA,wBAAwB,eAAe,EAAE;;AAEzC;EACE,iBAAiB;EACjB,gBAAgB;EAChB,qDAAqD;EACrD,6BAA6B;EAC7B,oCAAoC;EACpC,qBAAqB;AACvB;;AAEA,qBAAqB,WAAW,EAAE,iBAAiB,EAAE;;AAErD,eAAe;AACf;EACE,aAAa;EACb,sBAAsB;EACtB,SAAS;AACX;;AAEA;EACE,mBAAmB;EACnB,yBAAyB;EACzB,mBAAmB;EACnB,sBAAsB;EACtB,aAAa;EACb,sBAAsB;EACtB,WAAW;EACX,6BAA6B;AAC/B;;AAEA,2BAA2B,qBAAqB,EAAE;;AAElD;EACE,qBAAqB;EACrB,qDAAqD;AACvD;;AAEA;EACE,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;AAChB;;AAEA;EACE,kBAAkB;EAClB,WAAW;EACX,iBAAiB;AACnB;;AAEA,4BAA4B,cAAc,EAAE;;AAE5C,QAAQ;AACR;EACE,mBAAmB;EACnB,6BAA6B;EAC7B,gCAAgC;EAChC,oBAAoB;AACtB;;AAEA;EACE,kBAAkB;EAClB,iBAAiB;EACjB,gBAAgB;EAChB,qDAAqD;EACrD,6BAA6B;EAC7B,oCAAoC;EACpC,qBAAqB;EACrB,mBAAmB;AACrB;;AAEA;EACE,gBAAgB;EAChB,cAAc;EACd,aAAa;EACb,sBAAsB;EACtB,WAAW;AACb;;AAEA;EACE,mBAAmB;EACnB,yBAAyB;EACzB,mBAAmB;EACnB,gBAAgB;EAChB,6BAA6B;AAC/B;;AAEA,iBAAiB,qBAAqB,EAAE;;AAExC;EACE,WAAW;EACX,gBAAgB;EAChB,YAAY;EACZ,oBAAoB;EACpB,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;EACnB,SAAS;EACT,eAAe;EACf,oBAAoB;EACpB,iBAAiB;EACjB,gBAAgB;EAChB,cAAc;EACd,gBAAgB;AAClB;;AAEA;EACE,iBAAiB;EACjB,cAAc;EACd,cAAc;AAChB;;AAEA;EACE,sBAAsB;EACtB,kBAAkB;EAClB,WAAW;EACX,gBAAgB;EAChB,6BAA6B;EAC7B,mBAAmB;AACrB;;AAEA,UAAU;AACV;EACE,qDAAqD;EACrD,oBAAoB;EACpB,kBAAkB;AACpB;;AAEA;EACE,gBAAgB;EAChB,cAAc;EACd,kBAAkB;EAClB,cAAc;EACd,kBAAkB;EAClB,gBAAgB;EAChB,aAAa;EACb,sBAAsB;EACtB,WAAW;AACb;;AAEA;EACE,kBAAkB;EAClB,WAAW;EACX,kBAAkB;AACpB;;AAEA,eAAe;AACf;EACE;IACE,0BAA0B;EAC5B;EACA;IACE,aAAa;IACb,8BAA8B;EAChC;AACF;;AAEA;EACE,YAAY,0BAA0B,EAAE;EACxC,gBAAgB,0BAA0B,EAAE;EAC5C,qBAAqB,0BAA0B,EAAE;EACjD,gBAAgB,kBAAkB,EAAE;EACpC,eAAe,oBAAoB,EAAE;AACvC","sourcesContent":[".contact-page { min-height: 100vh; }\n\n/* Hero */\n.contact-hero {\n  position: relative;\n  padding: 5rem 2rem;\n  text-align: center;\n  background: radial-gradient(ellipse at center, #1a0800 0%, #0a0a0a 70%);\n  overflow: hidden;\n  border-bottom: 1px solid #1e1e1e;\n}\n\n.contact-hero-glow {\n  position: absolute;\n  top: 50%; left: 50%;\n  transform: translate(-50%, -50%);\n  width: 600px; height: 400px;\n  background: radial-gradient(circle, rgba(255,107,0,0.12) 0%, transparent 70%);\n  pointer-events: none;\n}\n\n.contact-hero-content {\n  position: relative;\n  max-width: 600px;\n  margin: 0 auto;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 1rem;\n}\n\n.contact-om { font-size: 3rem; }\n\n.contact-hero-content h1 {\n  font-size: clamp(1.8rem, 4vw, 2.8rem);\n  font-weight: 800;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n.contact-hero-content p {\n  color: #aaa;\n  font-size: 1rem;\n  line-height: 1.7;\n}\n\n/* Info Cards */\n.contact-info-section {\n  background: #0d0d0d;\n  border-bottom: 1px solid #1a1a1a;\n  padding: 2.5rem 2rem;\n}\n\n.contact-info-grid {\n  max-width: 1100px;\n  margin: 0 auto;\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));\n  gap: 1.2rem;\n}\n\n.contact-info-card {\n  background: #141414;\n  border: 1px solid #1e1e1e;\n  border-radius: 12px;\n  padding: 1.3rem 1.2rem;\n  display: flex;\n  align-items: flex-start;\n  gap: 1rem;\n  transition: border-color 0.2s, transform 0.2s;\n}\n\n.contact-info-card:hover {\n  border-color: #FF6B00;\n  transform: translateY(-3px);\n}\n\n.contact-info-icon { font-size: 1.8rem; flex-shrink: 0; }\n\n.contact-info-label {\n  font-size: 0.72rem;\n  color: #FF9933;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  margin-bottom: 0.2rem;\n}\n\n.contact-info-value {\n  font-size: 0.92rem;\n  font-weight: 600;\n  color: #fff5e6;\n  margin-bottom: 0.15rem;\n}\n\n.contact-info-sub { font-size: 0.75rem; color: #666; }\n\n/* Main â€” Form + Side */\n.contact-main {\n  max-width: 1100px;\n  margin: 0 auto;\n  padding: 3rem 2rem;\n  display: grid;\n  grid-template-columns: 1fr 340px;\n  gap: 2.5rem;\n  align-items: start;\n}\n\n/* Form */\n.contact-form-wrap h2 {\n  font-size: 1.5rem;\n  font-weight: 800;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  margin-bottom: 0.3rem;\n}\n\n.contact-form-sub {\n  color: #777;\n  font-size: 0.88rem;\n  margin-bottom: 1.8rem;\n}\n\n.contact-form {\n  display: flex;\n  flex-direction: column;\n  gap: 1.1rem;\n}\n\n.form-row {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 1.1rem;\n}\n\n.form-group {\n  display: flex;\n  flex-direction: column;\n  gap: 0.4rem;\n}\n\n.form-group label {\n  font-size: 0.8rem;\n  color: #aaa;\n  font-weight: 500;\n}\n\n.form-group input,\n.form-group textarea {\n  background: #141414;\n  border: 1px solid #2a2a2a;\n  border-radius: 8px;\n  padding: 0.7rem 1rem;\n  color: #fff5e6;\n  font-size: 0.9rem;\n  font-family: inherit;\n  outline: none;\n  transition: border-color 0.2s;\n  resize: vertical;\n}\n\n.form-group input:focus,\n.form-group textarea:focus {\n  border-color: #FF6B00;\n}\n\n.form-group input::placeholder,\n.form-group textarea::placeholder {\n  color: #444;\n}\n\n.contact-btn {\n  padding: 0.8rem 2rem;\n  background: linear-gradient(135deg, #FF6B00, #FF9933);\n  color: #fff;\n  border: none;\n  border-radius: 8px;\n  font-size: 0.95rem;\n  font-weight: 600;\n  cursor: pointer;\n  font-family: inherit;\n  transition: opacity 0.2s, transform 0.2s;\n  width: fit-content;\n}\n\n.contact-btn:hover { opacity: 0.88; transform: translateY(-2px); }\n\n/* Success */\n.contact-success {\n  background: #141414;\n  border: 1px solid #2a1200;\n  border-radius: 12px;\n  padding: 3rem 2rem;\n  text-align: center;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.8rem;\n}\n\n.contact-success span { font-size: 3rem; }\n\n.contact-success h3 {\n  font-size: 1.4rem;\n  font-weight: 700;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n.contact-success p { color: #aaa; font-size: 0.9rem; }\n\n/* Side Cards */\n.contact-side {\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n}\n\n.contact-side-card {\n  background: #141414;\n  border: 1px solid #1e1e1e;\n  border-radius: 12px;\n  padding: 1.2rem 1.3rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  transition: border-color 0.2s;\n}\n\n.contact-side-card:hover { border-color: #FF6B00; }\n\n.contact-side-card.highlight {\n  border-color: #2a1200;\n  background: linear-gradient(135deg, #1a0800, #141414);\n}\n\n.contact-side-card h3 {\n  font-size: 0.92rem;\n  font-weight: 700;\n  color: #FF9933;\n}\n\n.contact-side-card p {\n  font-size: 0.82rem;\n  color: #888;\n  line-height: 1.65;\n}\n\n.contact-side-card strong { color: #FF6B00; }\n\n/* FAQ */\n.contact-faq {\n  background: #0d0d0d;\n  border-top: 1px solid #1a1a1a;\n  border-bottom: 1px solid #1a1a1a;\n  padding: 3.5rem 2rem;\n}\n\n.contact-faq h2 {\n  text-align: center;\n  font-size: 1.5rem;\n  font-weight: 800;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  margin-bottom: 2rem;\n}\n\n.faq-list {\n  max-width: 760px;\n  margin: 0 auto;\n  display: flex;\n  flex-direction: column;\n  gap: 0.7rem;\n}\n\n.faq-item {\n  background: #141414;\n  border: 1px solid #1e1e1e;\n  border-radius: 10px;\n  overflow: hidden;\n  transition: border-color 0.2s;\n}\n\n.faq-item.open { border-color: #FF6B00; }\n\n.faq-q {\n  width: 100%;\n  background: none;\n  border: none;\n  padding: 1rem 1.2rem;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 1rem;\n  cursor: pointer;\n  font-family: inherit;\n  font-size: 0.9rem;\n  font-weight: 600;\n  color: #fff5e6;\n  text-align: left;\n}\n\n.faq-arrow {\n  font-size: 0.7rem;\n  color: #FF6B00;\n  flex-shrink: 0;\n}\n\n.faq-a {\n  padding: 0 1.2rem 1rem;\n  font-size: 0.85rem;\n  color: #999;\n  line-height: 1.7;\n  border-top: 1px solid #1e1e1e;\n  padding-top: 0.8rem;\n}\n\n/* Quote */\n.contact-quote {\n  background: linear-gradient(135deg, #1a0800, #0d0d0d);\n  padding: 3.5rem 2rem;\n  text-align: center;\n}\n\n.contact-quote blockquote {\n  max-width: 520px;\n  margin: 0 auto;\n  font-size: 1.25rem;\n  color: #FFD700;\n  font-style: italic;\n  line-height: 1.8;\n  display: flex;\n  flex-direction: column;\n  gap: 0.8rem;\n}\n\n.contact-quote cite {\n  font-size: 0.85rem;\n  color: #666;\n  font-style: normal;\n}\n\n/* Responsive */\n@media (max-width: 900px) {\n  .contact-main {\n    grid-template-columns: 1fr;\n  }\n  .contact-side {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n  }\n}\n\n@media (max-width: 600px) {\n  .form-row { grid-template-columns: 1fr; }\n  .contact-side { grid-template-columns: 1fr; }\n  .contact-info-grid { grid-template-columns: 1fr; }\n  .contact-main { padding: 2rem 1rem; }\n  .contact-faq { padding: 2.5rem 1rem; }\n}\n"],"sourceRoot":""}]);

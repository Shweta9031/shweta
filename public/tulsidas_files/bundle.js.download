___CSS_LOADER_EXPORT___.push([module.id, `/* â”€â”€ Page â”€â”€ */
.blogs-page {
  min-height: 100vh;
}

/* â”€â”€ Hero â”€â”€ */
.blogs-hero {
  position: relative;
  padding: 5rem 2rem;
  text-align: center;
  background: radial-gradient(ellipse at center, #1a0800 0%, #0a0a0a 70%);
  overflow: hidden;
  border-bottom: 1px solid #1e1e1e;
}

.blogs-hero-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600px;
  height: 400px;
  background: radial-gradient(circle, rgba(255,107,0, 0.12) 0%, transparent 70%);
  pointer-events: none;
}

.blogs-hero-content {
  position: relative;
  max-width: 650px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}

.blogs-om {
  font-size: 3rem;
}

.blogs-hero-content h1 {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00, #FFD700);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.blogs-hero-content p {
  color: #aaa;
  font-size: 1rem;
  line-height: 1.7;
}

/* â”€â”€ Filter â”€â”€ */
.blogs-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  justify-content: center;
  padding: 2rem 2rem 1rem;
  border-bottom: 1px solid #1a1a1a;
}

.filter-btn {
  padding: 0.45rem 1.1rem;
  border-radius: 20px;
  border: 1px solid #2a2a2a;
  background: #141414;
  color: #aaa;
  font-size: 0.82rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
  font-family: inherit;
}

.filter-btn:hover {
  border-color: #FF6B00;
  color: #FF6B00;
}

.filter-btn.active {
  background: linear-gradient(135deg, #FF6B00, #FF9933);
  border-color: transparent;
  color: #fff;
  font-weight: 600;
}

/* â”€â”€ Grid Section â”€â”€ */
.blogs-grid-section {
  max-width: 1280px;
  margin: 0 auto;
  padding: 2rem 2rem 4rem;
}

.blogs-count {
  font-size: 0.82rem;
  color: #555;
  margin-bottom: 1.5rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.blogs-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.5rem;
}

/* â”€â”€ Blog Card â”€â”€ */
.blog-card {
  background: #141414;
  border: 1px solid #1e1e1e;
  border-radius: 12px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
}

.blog-card:hover {
  transform: translateY(-4px);
  border-color: #FF6B00;
  box-shadow: 0 8px 30px rgba(255,107,0, 0.12);
}

.blog-card-img {
  position: relative;
  height: 200px;
  overflow: hidden;
  background: #1a1a1a;
}

.blog-card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.35s;
}

.blog-card:hover .blog-card-img img {
  transform: scale(1.06);
}

.blog-card-cat {
  position: absolute;
  top: 10px;
  left: 10px;
  padding: 3px 10px;
  border-radius: 20px;
  font-size: 0.68rem;
  font-weight: 600;
  color: #fff;
  letter-spacing: 0.03em;
}

.blog-card-body {
  padding: 1rem 1.1rem 1.2rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  flex: 1 1;
}

.blog-card-meta {
  display: flex;
  gap: 1rem;
  font-size: 0.73rem;
  color: #555;
}

.blog-card-body h3 {
  font-size: 0.95rem;
  font-weight: 700;
  color: #fff5e6;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.blog-card-body p {
  font-size: 0.82rem;
  color: #888;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex: 1 1;
}

.blog-read-btn {
  background: none;
  border: none;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  padding: 0;
  margin-top: 0.4rem;
  font-family: inherit;
  text-align: left;
  transition: opacity 0.2s;
}

.blog-read-btn:hover {
  opacity: 0.75;
}

/* â”€â”€ Responsive â”€â”€ */
@media (max-width: 600px) {
  .blogs-filter {
    gap: 0.4rem;
    padding: 1.5rem 1rem 0.8rem;
  }

  .filter-btn {
    font-size: 0.75rem;
    padding: 0.4rem 0.85rem;
  }

  .blogs-grid {
    grid-template-columns: 1fr;
  }

  .blogs-grid-section {
    padding: 1.5rem 1rem 3rem;
  }
}
`, "",{"version":3,"sources":["webpack://./src/pages/Blogs.css"],"names":[],"mappings":"AAAA,uBAAuB;AACvB;EACE,iBAAiB;AACnB;;AAEA,uBAAuB;AACvB;EACE,kBAAkB;EAClB,kBAAkB;EAClB,kBAAkB;EAClB,uEAAuE;EACvE,gBAAgB;EAChB,gCAAgC;AAClC;;AAEA;EACE,kBAAkB;EAClB,QAAQ;EACR,SAAS;EACT,gCAAgC;EAChC,YAAY;EACZ,aAAa;EACb,8EAA8E;EAC9E,oBAAoB;AACtB;;AAEA;EACE,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;EACd,aAAa;EACb,sBAAsB;EACtB,mBAAmB;EACnB,SAAS;AACX;;AAEA;EACE,eAAe;AACjB;;AAEA;EACE,qCAAqC;EACrC,gBAAgB;EAChB,qDAAqD;EACrD,6BAA6B;EAC7B,oCAAoC;EACpC,qBAAqB;AACvB;;AAEA;EACE,WAAW;EACX,eAAe;EACf,gBAAgB;AAClB;;AAEA,yBAAyB;AACzB;EACE,aAAa;EACb,eAAe;EACf,WAAW;EACX,uBAAuB;EACvB,uBAAuB;EACvB,gCAAgC;AAClC;;AAEA;EACE,uBAAuB;EACvB,mBAAmB;EACnB,yBAAyB;EACzB,mBAAmB;EACnB,WAAW;EACX,kBAAkB;EAClB,gBAAgB;EAChB,eAAe;EACf,oBAAoB;EACpB,oBAAoB;AACtB;;AAEA;EACE,qBAAqB;EACrB,cAAc;AAChB;;AAEA;EACE,qDAAqD;EACrD,yBAAyB;EACzB,WAAW;EACX,gBAAgB;AAClB;;AAEA,+BAA+B;AAC/B;EACE,iBAAiB;EACjB,cAAc;EACd,uBAAuB;AACzB;;AAEA;EACE,kBAAkB;EAClB,WAAW;EACX,qBAAqB;EACrB,yBAAyB;EACzB,sBAAsB;AACxB;;AAEA;EACE,aAAa;EACb,4DAA4D;EAC5D,WAAW;AACb;;AAEA,4BAA4B;AAC5B;EACE,mBAAmB;EACnB,yBAAyB;EACzB,mBAAmB;EACnB,gBAAgB;EAChB,aAAa;EACb,sBAAsB;EACtB,iEAAiE;AACnE;;AAEA;EACE,2BAA2B;EAC3B,qBAAqB;EACrB,4CAA4C;AAC9C;;AAEA;EACE,kBAAkB;EAClB,aAAa;EACb,gBAAgB;EAChB,mBAAmB;AACrB;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,iBAAiB;EACjB,2BAA2B;AAC7B;;AAEA;EACE,sBAAsB;AACxB;;AAEA;EACE,kBAAkB;EAClB,SAAS;EACT,UAAU;EACV,iBAAiB;EACjB,mBAAmB;EACnB,kBAAkB;EAClB,gBAAgB;EAChB,WAAW;EACX,sBAAsB;AACxB;;AAEA;EACE,2BAA2B;EAC3B,aAAa;EACb,sBAAsB;EACtB,WAAW;EACX,SAAO;AACT;;AAEA;EACE,aAAa;EACb,SAAS;EACT,kBAAkB;EAClB,WAAW;AACb;;AAEA;EACE,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;EACd,gBAAgB;EAChB,oBAAoB;EACpB,qBAAqB;EACrB,4BAA4B;EAC5B,gBAAgB;AAClB;;AAEA;EACE,kBAAkB;EAClB,WAAW;EACX,gBAAgB;EAChB,oBAAoB;EACpB,qBAAqB;EACrB,4BAA4B;EAC5B,gBAAgB;EAChB,SAAO;AACT;;AAEA;EACE,gBAAgB;EAChB,YAAY;EACZ,kBAAkB;EAClB,gBAAgB;EAChB,eAAe;EACf,UAAU;EACV,kBAAkB;EAClB,oBAAoB;EACpB,gBAAgB;EAChB,wBAAwB;AAC1B;;AAEA;EACE,aAAa;AACf;;AAEA,6BAA6B;AAC7B;EACE;IACE,WAAW;IACX,2BAA2B;EAC7B;;EAEA;IACE,kBAAkB;IAClB,uBAAuB;EACzB;;EAEA;IACE,0BAA0B;EAC5B;;EAEA;IACE,yBAAyB;EAC3B;AACF","sourcesContent":["/* â”€â”€ Page â”€â”€ */\n.blogs-page {\n  min-height: 100vh;\n}\n\n/* â”€â”€ Hero â”€â”€ */\n.blogs-hero {\n  position: relative;\n  padding: 5rem 2rem;\n  text-align: center;\n  background: radial-gradient(ellipse at center, #1a0800 0%, #0a0a0a 70%);\n  overflow: hidden;\n  border-bottom: 1px solid #1e1e1e;\n}\n\n.blogs-hero-glow {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  width: 600px;\n  height: 400px;\n  background: radial-gradient(circle, rgba(255,107,0, 0.12) 0%, transparent 70%);\n  pointer-events: none;\n}\n\n.blogs-hero-content {\n  position: relative;\n  max-width: 650px;\n  margin: 0 auto;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 1rem;\n}\n\n.blogs-om {\n  font-size: 3rem;\n}\n\n.blogs-hero-content h1 {\n  font-size: clamp(1.8rem, 4vw, 2.8rem);\n  font-weight: 800;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n.blogs-hero-content p {\n  color: #aaa;\n  font-size: 1rem;\n  line-height: 1.7;\n}\n\n/* â”€â”€ Filter â”€â”€ */\n.blogs-filter {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.6rem;\n  justify-content: center;\n  padding: 2rem 2rem 1rem;\n  border-bottom: 1px solid #1a1a1a;\n}\n\n.filter-btn {\n  padding: 0.45rem 1.1rem;\n  border-radius: 20px;\n  border: 1px solid #2a2a2a;\n  background: #141414;\n  color: #aaa;\n  font-size: 0.82rem;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.2s;\n  font-family: inherit;\n}\n\n.filter-btn:hover {\n  border-color: #FF6B00;\n  color: #FF6B00;\n}\n\n.filter-btn.active {\n  background: linear-gradient(135deg, #FF6B00, #FF9933);\n  border-color: transparent;\n  color: #fff;\n  font-weight: 600;\n}\n\n/* â”€â”€ Grid Section â”€â”€ */\n.blogs-grid-section {\n  max-width: 1280px;\n  margin: 0 auto;\n  padding: 2rem 2rem 4rem;\n}\n\n.blogs-count {\n  font-size: 0.82rem;\n  color: #555;\n  margin-bottom: 1.5rem;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n\n.blogs-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n  gap: 1.5rem;\n}\n\n/* â”€â”€ Blog Card â”€â”€ */\n.blog-card {\n  background: #141414;\n  border: 1px solid #1e1e1e;\n  border-radius: 12px;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;\n}\n\n.blog-card:hover {\n  transform: translateY(-4px);\n  border-color: #FF6B00;\n  box-shadow: 0 8px 30px rgba(255,107,0, 0.12);\n}\n\n.blog-card-img {\n  position: relative;\n  height: 200px;\n  overflow: hidden;\n  background: #1a1a1a;\n}\n\n.blog-card-img img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.35s;\n}\n\n.blog-card:hover .blog-card-img img {\n  transform: scale(1.06);\n}\n\n.blog-card-cat {\n  position: absolute;\n  top: 10px;\n  left: 10px;\n  padding: 3px 10px;\n  border-radius: 20px;\n  font-size: 0.68rem;\n  font-weight: 600;\n  color: #fff;\n  letter-spacing: 0.03em;\n}\n\n.blog-card-body {\n  padding: 1rem 1.1rem 1.2rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  flex: 1;\n}\n\n.blog-card-meta {\n  display: flex;\n  gap: 1rem;\n  font-size: 0.73rem;\n  color: #555;\n}\n\n.blog-card-body h3 {\n  font-size: 0.95rem;\n  font-weight: 700;\n  color: #fff5e6;\n  line-height: 1.4;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n.blog-card-body p {\n  font-size: 0.82rem;\n  color: #888;\n  line-height: 1.6;\n  display: -webkit-box;\n  -webkit-line-clamp: 3;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n  flex: 1;\n}\n\n.blog-read-btn {\n  background: none;\n  border: none;\n  font-size: 0.82rem;\n  font-weight: 600;\n  cursor: pointer;\n  padding: 0;\n  margin-top: 0.4rem;\n  font-family: inherit;\n  text-align: left;\n  transition: opacity 0.2s;\n}\n\n.blog-read-btn:hover {\n  opacity: 0.75;\n}\n\n/* â”€â”€ Responsive â”€â”€ */\n@media (max-width: 600px) {\n  .blogs-filter {\n    gap: 0.4rem;\n    padding: 1.5rem 1rem 0.8rem;\n  }\n\n  .filter-btn {\n    font-size: 0.75rem;\n    padding: 0.4rem 0.85rem;\n  }\n\n  .blogs-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .blogs-grid-section {\n    padding: 1.5rem 1rem 3rem;\n  }\n}\n"],"sourceRoot":""}]);

AACA,qBAAqB,kBAAkB,EAAE,WAAW,EAAE,SAAS,EAAE;;AAEjE,4BAA4B;AAC5B,cAAc,kBAAkB,EAAE,iBAAiB,EAAE,cAAc,EAAE;AACrE,qBAAqB,kBAAkB,EAAE,qBAAqB,EAAE;AAChE;EACE,iBAAiB,EAAE,gBAAgB;EACnC,qDAAqD;EACrD,6BAA6B,EAAE,oCAAoC,EAAE,qBAAqB;EAC1F,qBAAqB;AACvB;AACA,uBAAuB,WAAW,EAAE,kBAAkB,EAAE;;AAExD,mBAAmB,aAAa,EAAE,qCAAqC,EAAE,WAAW,EAAE,qBAAqB,EAAE;;AAE7G,mBAAmB,mBAAmB,EAAE,yBAAyB,EAAE,mBAAmB,EAAE,eAAe,EAAE,aAAa,EAAE,sBAAsB,EAAE,WAAW,EAAE,6CAA6C,EAAE;AAC5M,yBAAyB,qBAAqB,EAAE,2BAA2B,EAAE;;AAE7E,kBAAkB,aAAa,EAAE,mBAAmB,EAAE,WAAW,EAAE;AACnE;EACE,WAAW,EAAE,YAAY,EAAE,kBAAkB;EAC7C,qDAAqD;EACrD,aAAa,EAAE,mBAAmB,EAAE,uBAAuB;EAC3D,iBAAiB,EAAE,gBAAgB,EAAE,WAAW,EAAE,cAAc;AAClE;AACA,qBAAqB,iBAAiB,EAAE,gBAAgB,EAAE,cAAc,EAAE,qBAAqB,EAAE;AACjG,mBAAmB,kBAAkB,EAAE,WAAW,EAAE,qBAAqB,EAAE;AAC3E,oBAAoB,aAAa,EAAE,QAAQ,EAAE,iBAAiB,EAAE;AAChE,oBAAoB,qBAAqB,EAAE,kBAAkB,EAAE,iBAAiB,EAAE,mBAAmB,EAAE,kBAAkB,EAAE,gBAAgB,EAAE,gCAAgC,EAAE,cAAc,EAAE,sCAAsC,EAAE;AACvO,mBAAmB,kBAAkB,EAAE,WAAW,EAAE,gBAAgB,EAAE,kBAAkB,EAAE;;AAE1F,qBAAqB;AACrB;EACE,QAAQ,sBAAsB,EAAE,gBAAgB,EAAE,UAAU,EAAE,kBAAkB,EAAE;EAClF,aAAa,UAAU,EAAE,WAAW,EAAE,kBAAkB,EAAE,mBAAmB,EAAE;EAC/E,aAAa,eAAe,EAAE;EAC9B,cAAc,uBAAuB,EAAE;EACvC,cAAc,UAAU,EAAE,WAAW,EAAE,sBAAsB,EAAE;EAC/D,UAAU,aAAa,EAAE;EACzB,oBAAoB,0BAA0B,EAAE;EAChD,oBAAoB,oCAAoC,EAAE;EAC1D,mBAAmB,0BAA0B,EAAE;AACjD;AACA;EACE,UAAU,aAAa,EAAE;EACzB,qBAAqB,0BAA0B,EAAE;EACjD,oBAAoB,8BAA8B,EAAE;AACtD","sourcesContent":[".home { min-height: 100vh; }\n\n/* ── Hero ── */\n.hero {\n  position: relative; min-height: 92vh;\n  display: flex; align-items: stretch; gap: 0; padding: 0; overflow: hidden;\n  background: radial-gradient(ellipse at 30% 50%, #1a0800 0%, #0a0a0a 65%);\n}\n\n.hero-glow {\n  position: absolute; top: 50%; left: 30%; transform: translate(-50%, -50%);\n  width: 500px; height: 500px;\n  background: radial-gradient(circle, rgba(255,107,0,0.1) 0%, transparent 70%);\n  pointer-events: none;\n}\n\n.hero-left {\n  flex: 0 0 50%; min-width: 0; display: flex; flex-direction: column;\n  gap: 1.4rem; z-index: 1; padding: 3rem 2rem 3rem 3rem; justify-content: center;\n}\n\n.hero-om { font-size: 3.5rem; animation: pulse 3s ease-in-out infinite; line-height: 1; }\n\n@keyframes pulse {\n  0%,100% { transform: scale(1); opacity: 1; }\n  50% { transform: scale(1.1); opacity: 0.8; }\n}\n\n.hero-left h1 { display: flex; flex-direction: column; gap: 0.4rem; }\n\n.hero-title-main {\n  font-size: clamp(2.2rem, 4.5vw, 3.5rem); font-weight: 800;\n  background: linear-gradient(135deg, #FF6B00, #FFD700, #FF6B00);\n  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\n  line-height: 1.1;\n}\n\n.hero-title-sub { font-size: clamp(0.95rem, 1.8vw, 1.15rem); color: #bbb; font-weight: 400; }\n.hero-desc { color: #999; font-size: 0.97rem; line-height: 1.75; max-width: 480px; }\n\n.hero-stats { display: flex; gap: 1.5rem; flex-wrap: wrap; }\n.hero-stat { display: flex; flex-direction: column; gap: 0.15rem; }\n\n.hero-stat-value {\n  font-size: 1.5rem; font-weight: 800;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\n  line-height: 1;\n}\n\n.hero-stat-label { font-size: 0.75rem; color: #666; text-transform: uppercase; letter-spacing: 0.05em; }\n.hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }\n\n.btn-primary {\n  padding: 0.75rem 1.8rem;\n  background: linear-gradient(135deg, #FF6B00, #FF9933);\n  color: #fff; border-radius: 8px; font-weight: 600; font-size: 0.95rem;\n  transition: opacity 0.2s, transform 0.2s; border: none; cursor: pointer; display: inline-block;\n}\n.btn-primary:hover { opacity: 0.9; transform: translateY(-2px); }\n\n.btn-secondary {\n  padding: 0.75rem 1.8rem; background: transparent;\n  color: #FF6B00; border: 1px solid #FF6B00; border-radius: 8px;\n  font-weight: 600; font-size: 0.95rem; transition: background 0.2s; display: inline-block;\n}\n.btn-secondary:hover { background: rgba(255,107,0,0.1); }\n\n.hero-right { flex: 0 0 50%; z-index: 1; display: flex; align-items: center; justify-content: center; padding: 2rem 2rem 2rem 1.5rem; }\n\n.slider {\n  position: relative; width: 100%; height: 500px;\n  border-radius: 24px; overflow: hidden;\n  border: 1px solid #2a1200;\n  box-shadow: 0 20px 60px rgba(0,0,0,0.5);\n}\n\n.slide { position: absolute; inset: 0; opacity: 0; transition: opacity 0.7s ease; }\n.slide.active { opacity: 1; }\n.slide img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }\n\n.slide-overlay {\n  position: absolute; inset: 0;\n  background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.1) 55%, transparent 100%);\n}\n\n.slide-caption { position: absolute; bottom: 0; left: 0; right: 0; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.35rem; }\n.slide-category { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: 600; color: #fff; width: fit-content; }\n.slide-caption h3 { font-size: 1.25rem; font-weight: 700; color: #fff; line-height: 1.2; }\n.slide-caption p { font-size: 0.82rem; color: #FF9933; }\n.slide-location { font-size: 0.78rem; color: #aaa; }\n\n.slider-dots { position: absolute; bottom: 1rem; right: 1rem; display: flex; gap: 6px; z-index: 10; }\n.dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,0.3); border: none; cursor: pointer; padding: 0; transition: background 0.3s, transform 0.2s; }\n.dot.active { transform: scale(1.3); }\n\n.slider-arrow {\n  position: absolute; top: 50%; transform: translateY(-50%);\n  background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1);\n  color: #fff; width: 36px; height: 36px; border-radius: 50%;\n  font-size: 1.4rem; line-height: 1; cursor: pointer; z-index: 10;\n  display: flex; align-items: center; justify-content: center; transition: background 0.2s;\n}\n.slider-arrow:hover { background: rgba(255,107,0,0.6); }\n.slider-arrow.prev { left: 10px; }\n.slider-arrow.next { right: 10px; }\n\n/* ── Featured ── */\n.featured-section { max-width: 1200px; margin: 0 auto; padding: 4rem 2rem; }\n\n.section-header { text-align: center; margin-bottom: 2.5rem; }\n.section-header h2 {\n  font-size: 1.8rem; font-weight: 700;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\n  margin-bottom: 0.5rem;\n}\n.section-header p { color: #888; font-size: 0.95rem; }\n\n.cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }\n.view-all-wrap { text-align: center; margin-top: 2.5rem; }\n\n/* ── Quote ── */\n.quote-section {\n  background: linear-gradient(135deg, #1a0800, #0d0d0d);\n  border-top: 1px solid #2a1200; border-bottom: 1px solid #2a1200;\n  padding: 3rem 2rem; text-align: center;\n}\n.quote-section blockquote {\n  max-width: 620px; margin: 0 auto; font-size: 1.3rem;\n  color: #FFD700; font-style: italic; line-height: 1.8;\n  display: flex; flex-direction: column; gap: 0.8rem;\n}\n.quote-section cite { font-size: 0.88rem; color: #777; font-style: normal; }\n\n/* ── Home About ── */\n.home-about {\n  padding: 4rem 2rem;\n  background: #0d0d0d;\n  border-top: 1px solid #2a1200;\n  border-bottom: 1px solid #2a1200;\n}\n.home-about-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 300px; gap: 3rem; align-items: center; }\n\n.home-about-tag { font-size: 0.75rem; font-weight: 600; color: #FF6B00; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem; display: block; }\n\n.home-about-text h2 {\n  font-size: 1.8rem; font-weight: 800;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\n  margin-bottom: 1rem;\n}\n.home-about-text p { color: #aaa; font-size: 0.95rem; line-height: 1.8; margin-bottom: 1.5rem; }\n\n.home-about-values { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; margin-bottom: 1.8rem; }\n.home-about-value { display: flex; align-items: center; gap: 0.6rem; background: #141414; border: 1px solid #1e1e1e; border-radius: 8px; padding: 0.6rem 0.8rem; }\n.home-about-value span { font-size: 1.2rem; }\n.home-about-value p { font-size: 0.8rem; color: #ccc; font-weight: 500; margin: 0; }\n\n.home-about-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }\n.home-about-stat { background: #141414; border: 1px solid #1e1e1e; border-radius: 12px; padding: 1.2rem; text-align: center; transition: border-color 0.2s; }\n.home-about-stat:hover { border-color: #FF6B00; }\n.home-about-stat span {\n  display: block; font-size: 1.8rem; font-weight: 800;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\n  margin-bottom: 0.3rem;\n}\n.home-about-stat p { font-size: 0.78rem; color: #777; margin: 0; }\n\n/* ── Home Testimonials ── */\n.home-testi { padding: 4rem 2rem; max-width: 1100px; margin: 0 auto; }\n.home-testi-header { text-align: center; margin-bottom: 2.5rem; }\n.home-testi-header h2 {\n  font-size: 1.8rem; font-weight: 800;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\n  margin-bottom: 0.4rem;\n}\n.home-testi-header p { color: #888; font-size: 0.95rem; }\n\n.home-testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 2.5rem; }\n\n.home-testi-card { background: #141414; border: 1px solid #1e1e1e; border-radius: 14px; padding: 1.4rem; display: flex; flex-direction: column; gap: 0.8rem; transition: border-color 0.2s, transform 0.2s; }\n.home-testi-card:hover { border-color: #FF6B00; transform: translateY(-3px); }\n\n.home-testi-top { display: flex; align-items: center; gap: 0.8rem; }\n.home-testi-avatar {\n  width: 48px; height: 48px; border-radius: 50%;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  display: flex; align-items: center; justify-content: center;\n  font-size: 1.2rem; font-weight: 700; color: #fff; flex-shrink: 0;\n}\n.home-testi-top h4 { font-size: 0.9rem; font-weight: 700; color: #fff5e6; margin-bottom: 0.1rem; }\n.home-testi-city { font-size: 0.72rem; color: #666; margin-bottom: 0.2rem; }\n.home-testi-stars { display: flex; gap: 2px; font-size: 0.8rem; }\n.home-testi-badge { display: inline-block; width: fit-content; padding: 3px 10px; border-radius: 20px; font-size: 0.68rem; font-weight: 600; background: rgba(255,107,0,0.12); color: #FF9933; border: 1px solid rgba(255,107,0,0.25); }\n.home-testi-text { font-size: 0.83rem; color: #999; line-height: 1.7; font-style: italic; }\n\n/* ── Responsive ── */\n@media (max-width: 900px) {\n  .hero { flex-direction: column; min-height: auto; padding: 0; text-align: center; }\n  .hero-left { flex: none; width: 100%; padding: 3rem 2rem; align-items: center; }\n  .hero-desc { max-width: 100%; }\n  .hero-stats { justify-content: center; }\n  .hero-right { flex: none; width: 100%; padding: 0 1.5rem 2rem; }\n  .slider { height: 400px; }\n  .home-about-inner { grid-template-columns: 1fr; }\n  .home-about-stats { grid-template-columns: repeat(4,1fr); }\n  .home-testi-grid { grid-template-columns: 1fr; }\n}\n@media (max-width: 600px) {\n  .slider { height: 320px; }\n  .home-about-values { grid-template-columns: 1fr; }\n  .home-about-stats { grid-template-columns: 1fr 1fr; }\n}\n"],"sourceRoot":""}]);

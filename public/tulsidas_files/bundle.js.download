const babas = [{
  id: 1,
  name: "Premanand Ji Maharaj",
  title: "Vrindavan Ke Vaishnav Sant",
  location: "Vrindavan, Uttar Pradesh",
  born: "1950s",
  image: "/premanand1.jpg",
  shortDesc: "Vrindavan mein rehne wale prasiddh Vaishnav sant, bhakti aur satsang ke liye jaane jaate hain",
  fullDesc: "Premanand Ji Maharaj Vrindavan ke ek prasiddh Vaishnav sant hain jo Radha-Krishna ki bhakti mein apna jeevan samarpit kar chuke hain. Woh apne pravachano mein bhakti, vairagya aur Bhagwat Geeta ka sandesh dete hain. Unke satsang mein lakho log aate hain aur unka YouTube channel bhi bahut popular hai. Woh sadgi aur satya ke prateek maane jaate hain.",
  work: ["Bhakti pravachan", "Radha-Krishna katha", "Satsang aayojan", "Vairagya ka sandesh", "Gita pravachan"],
  followers: "2 Crore+",
  youtube: "Premanand Ji Maharaj",
  category: "Vaishnav Sant",
  color: "#FF8C00",
  bgColor: "from-yellow-900 to-orange-700"

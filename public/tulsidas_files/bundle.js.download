___CSS_LOADER_EXPORT___.push([module.id, `.contact-page { min-height: 100vh; }

/* Hero */
.contact-hero {
  position: relative;
  padding: 5rem 2rem;
  text-align: center;
  background: radial-gradient(ellipse at center, #1a0800 0%, #0a0a0a 70%);
  overflow: hidden;
  border-bottom: 1px solid #1e1e1e;
}

.contact-hero-glow {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 600px; height: 400px;
  background: radial-gradient(circle, rgba(255,107,0,0.12) 0%, transparent 70%);
  pointer-events: none;
}

.contact-hero-content {
  position: relative;
  max-width: 600px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}

.contact-om { font-size: 3rem; }

.contact-hero-content h1 {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00, #FFD700);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.contact-hero-content p {
  color: #aaa;
  font-size: 1rem;
  line-height: 1.7;
}

/* Info Cards */
.contact-info-section {
  background: #0d0d0d;
  border-bottom: 1px solid #1a1a1a;
  padding: 2.5rem 2rem;
}

.contact-info-grid {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  gap: 1.2rem;
}

.contact-info-card {
  background: #141414;
  border: 1px solid #1e1e1e;
  border-radius: 12px;
  padding: 1.3rem 1.2rem;
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  transition: border-color 0.2s, transform 0.2s;
}

.contact-info-card:hover {
  border-color: #FF6B00;
  transform: translateY(-3px);
}

.contact-info-icon { font-size: 1.8rem; flex-shrink: 0; }

.contact-info-label {
  font-size: 0.72rem;
  color: #FF9933;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 0.2rem;
}

.contact-info-value {
  font-size: 0.92rem;
  font-weight: 600;
  color: #fff5e6;
  margin-bottom: 0.15rem;
}

.contact-info-sub { font-size: 0.75rem; color: #666; }

/* Main â€” Form + Side */
.contact-main {
  max-width: 1100px;
  margin: 0 auto;
  padding: 3rem 2rem;
  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 2.5rem;
  align-items: start;
}

/* Form */
.contact-form-wrap h2 {
  font-size: 1.5rem;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00, #FFD700);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 0.3rem;
}

.contact-form-sub {
  color: #777;
  font-size: 0.88rem;
  margin-bottom: 1.8rem;
}

.contact-form {
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.1rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.form-group label {
  font-size: 0.8rem;
  color: #aaa;
  font-weight: 500;
}

.form-group input,
.form-group textarea {
  background: #141414;
  border: 1px solid #2a2a2a;
  border-radius: 8px;
  padding: 0.7rem 1rem;
  color: #fff5e6;
  font-size: 0.9rem;
  font-family: inherit;
  outline: none;
  transition: border-color 0.2s;
  resize: vertical;
}

.form-group input:focus,
.form-group textarea:focus {
  border-color: #FF6B00;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
  color: #444;
}

.contact-btn {
  padding: 0.8rem 2rem;
  background: linear-gradient(135deg, #FF6B00, #FF9933);
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  font-family: inherit;
  transition: opacity 0.2s, transform 0.2s;
  width: fit-content;
}

.contact-btn:hover { opacity: 0.88; transform: translateY(-2px); }

/* Success */
.contact-success {
  background: #141414;
  border: 1px solid #2a1200;
  border-radius: 12px;
  padding: 3rem 2rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.8rem;
}

.contact-success span { font-size: 3rem; }

.contact-success h3 {
  font-size: 1.4rem;
  font-weight: 700;
  background: linear-gradient(135deg, #FF6B00, #FFD700);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.contact-success p { color: #aaa; font-size: 0.9rem; }

/* Side Cards */
.contact-side {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.contact-side-card {
  background: #141414;
  border: 1px solid #1e1e1e;
  border-radius: 12px;
  padding: 1.2rem 1.3rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  transition: border-color 0.2s;
}

.contact-side-card:hover { border-color: #FF6B00; }

.contact-side-card.highlight {
  border-color: #2a1200;
  background: linear-gradient(135deg, #1a0800, #141414);
}

.contact-side-card h3 {
  font-size: 0.92rem;
  font-weight: 700;
  color: #FF9933;
}

.contact-side-card p {
  font-size: 0.82rem;
  color: #888;
  line-height: 1.65;
}

.contact-side-card strong { color: #FF6B00; }

/* FAQ */
.contact-faq {
  background: #0d0d0d;
  border-top: 1px solid #1a1a1a;
  border-bottom: 1px solid #1a1a1a;
  padding: 3.5rem 2rem;
}

.contact-faq h2 {
  text-align: center;
  font-size: 1.5rem;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00, #FFD700);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 2rem;
}

.faq-list {
  max-width: 760px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}

.faq-item {
  background: #141414;
  border: 1px solid #1e1e1e;
  border-radius: 10px;
  overflow: hidden;
  transition: border-color 0.2s;
}

.faq-item.open { border-color: #FF6B00; }

.faq-q {
  width: 100%;
  background: none;
  border: none;
  padding: 1rem 1.2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  cursor: pointer;
  font-family: inherit;
  font-size: 0.9rem;
  font-weight: 600;
  color: #fff5e6;
  text-align: left;
}

.faq-arrow {
  font-size: 0.7rem;
  color: #FF6B00;
  flex-shrink: 0;
}

.faq-a {
  padding: 0 1.2rem 1rem;
  font-size: 0.85rem;
  color: #999;
  line-height: 1.7;
  border-top: 1px solid #1e1e1e;
  padding-top: 0.8rem;
}

/* Quote */
.contact-quote {
  background: linear-gradient(135deg, #1a0800, #0d0d0d);
  padding: 3.5rem 2rem;
  text-align: center;
}

.contact-quote blockquote {
  max-width: 520px;
  margin: 0 auto;
  font-size: 1.25rem;
  color: #FFD700;
  font-style: italic;
  line-height: 1.8;
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.contact-quote cite {
  font-size: 0.85rem;
  color: #666;
  font-style: normal;
}

/* Responsive */
@media (max-width: 900px) {
  .contact-main {
    grid-template-columns: 1fr;
  }
  .contact-side {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 600px) {
  .form-row { grid-template-columns: 1fr; }
  .contact-side { grid-template-columns: 1fr; }
  .contact-info-grid { grid-template-columns: 1fr; }
  .contact-main { padding: 2rem 1rem; }
  .contact-faq { padding: 2.5rem 1rem; }
}

___CSS_LOADER_EXPORT___.push([module.id, `.testi-page { min-height: 100vh; }

/* Hero */
.testi-hero {
  position: relative;
  padding: 5rem 2rem;
  text-align: center;
  background: radial-gradient(ellipse at center, #1a0800 0%, #0a0a0a 70%);
  overflow: hidden;
  border-bottom: 1px solid #1e1e1e;
}

.testi-hero-glow {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 600px; height: 400px;
  background: radial-gradient(circle, rgba(255,107,0,0.12) 0%, transparent 70%);
  pointer-events: none;
}

.testi-hero-content {
  position: relative;
  max-width: 600px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}

.testi-om { font-size: 3rem; }

.testi-hero-content h1 {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00, #FFD700);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.testi-hero-content p {
  color: #aaa;
  font-size: 1rem;
  line-height: 1.7;
}

/* Stats */
.testi-stats {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  background: #0d0d0d;
  border-bottom: 1px solid #1a1a1a;
}

.testi-stat {
  flex: 1 1;
  min-width: 130px;
  text-align: center;
  padding: 1.8rem 1rem;
  border-right: 1px solid #1e1e1e;
}

.testi-stat:last-child { border-right: none; }

.testi-stat span {
  display: block;
  font-size: 2rem;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00, #FFD700);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 0.3rem;
}

.testi-stat p { color: #777; font-size: 0.82rem; }

/* Filter */
.testi-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  justify-content: center;
  padding: 2rem 2rem 1rem;
  border-bottom: 1px solid #1a1a1a;
}

.testi-filter-btn {
  padding: 0.42rem 1rem;
  border-radius: 20px;
  border: 1px solid #2a2a2a;
  background: #141414;
  color: #aaa;
  font-size: 0.8rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
  font-family: inherit;
}

.testi-filter-btn:hover { border-color: #FF6B00; color: #FF6B00; }

.testi-filter-btn.active {
  background: linear-gradient(135deg, #FF6B00, #FF9933);
  border-color: transparent;
  color: #fff;
  font-weight: 600;
}

/* Grid */
.testi-grid-section {
  max-width: 1280px;
  margin: 0 auto;
  padding: 2rem 2rem 4rem;
}

.testi-count {
  font-size: 0.82rem;
  color: #555;
  margin-bottom: 1.5rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.testi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1.5rem;
}

/* Card */
.testi-card {
  background: #141414;
  border: 1px solid #1e1e1e;
  border-radius: 14px;
  padding: 1.4rem;
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
  transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
}

.testi-card:hover {
  transform: translateY(-4px);
  border-color: #FF6B00;
  box-shadow: 0 8px 30px rgba(255,107,0,0.12);
}

.testi-card-top {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.testi-avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid #FF6B00;
  flex-shrink: 0;
}

.testi-info { display: flex; flex-direction: column; gap: 0.2rem; }

.testi-info h3 {
  font-size: 0.95rem;
  font-weight: 700;
  color: #fff5e6;
}

.testi-city { font-size: 0.75rem; color: #666; }

/* Stars */
.stars { display: flex; gap: 2px; }

.star { font-size: 0.85rem; color: #333; }
.star.filled { color: #FFD700; }

/* Badge */
.testi-badge {
  display: inline-block;
  width: fit-content;
  padding: 3px 10px;
  border-radius: 20px;
  font-size: 0.68rem;
  font-weight: 600;
  background: rgba(255,107,0,0.15);
  color: #FF9933;
  border: 1px solid rgba(255,107,0,0.25);
}

/* Text */
.testi-text {
  font-size: 0.85rem;
  color: #999;
  line-height: 1.7;
  font-style: italic;
  flex: 1 1;
}

/* Quote */
.testi-quote {
  background: linear-gradient(135deg, #1a0800, #0d0d0d);
  border-top: 1px solid #2a1200;
  padding: 3.5rem 2rem;
  text-align: center;
}

.testi-quote blockquote {
  max-width: 580px;
  margin: 0 auto;
  font-size: 1.25rem;
  color: #FFD700;
  font-style: italic;
  line-height: 1.8;
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.testi-quote cite {
  font-size: 0.85rem;
  color: #666;
  font-style: normal;
}

/* Responsive */
@media (max-width: 600px) {
  .testi-filter { padding: 1.5rem 1rem 0.8rem; gap: 0.4rem; }
  .testi-filter-btn { font-size: 0.73rem; padding: 0.38rem 0.8rem; }
  .testi-grid { grid-template-columns: 1fr; }
  .testi-grid-section { padding: 1.5rem 1rem 3rem; }
  .testi-stat { min-width: 100px; padding: 1.2rem 0.5rem; }
}

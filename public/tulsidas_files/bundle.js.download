// Module
___CSS_LOADER_EXPORT___.push([module.id, `.baba-card {
  display: flex; flex-direction: column;
  background: #141414; border: 1px solid #1e1e1e;
  border-radius: 12px; overflow: hidden;
  transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
  cursor: pointer;
}
.baba-card:hover {
  transform: translateY(-4px);
  border-color: #FF6B00;
  box-shadow: 0 8px 30px rgba(255,107,0,0.15);
}

.baba-card-img-wrap {
  position: relative;
  height: 260px;
  overflow: hidden;
  background: #1a1a1a;
}
.baba-card-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  transition: transform 0.3s;
  display: block;
}
.baba-card:hover .baba-card-img-wrap img { transform: scale(1.05); }

.baba-card-category { position: absolute; top: 10px; right: 10px; padding: 3px 10px; border-radius: 20px; font-size: 0.72rem; font-weight: 600; color: #fff; }

.baba-card-body { padding: 1rem; display: flex; flex-direction: column; gap: 0.35rem; flex: 1 1; }
.baba-card-body h3 { font-size: 1rem; font-weight: 700; color: #fff5e6; }
.baba-card-title { font-size: 0.8rem; color: #FF9933; font-weight: 500; }
.baba-card-location { font-size: 0.78rem; color: #888; }
.baba-card-desc { font-size: 0.82rem; color: #aaa; line-height: 1.5; margin-top: 0.2rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

.baba-card-footer { display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 0.6rem; border-top: 1px solid #1e1e1e; }
.baba-card-followers { font-size: 0.78rem; color: #777; }
.baba-card-more { font-size: 0.8rem; font-weight: 600; color: #FF6B00; }
`, "",{"version":3,"sources":["webpack://./src/components/BabaCard.css"],"names":[],"mappings":"AAAA;EACE,aAAa,EAAE,sBAAsB;EACrC,mBAAmB,EAAE,yBAAyB;EAC9C,mBAAmB,EAAE,gBAAgB;EACrC,iEAAiE;EACjE,eAAe;AACjB;AACA;EACE,2BAA2B;EAC3B,qBAAqB;EACrB,2CAA2C;AAC7C;;AAEA;EACE,kBAAkB;EAClB,aAAa;EACb,gBAAgB;EAChB,mBAAmB;AACrB;AACA;EACE,WAAW;EACX,YAAY;EACZ,iBAAiB;EACjB,2BAA2B;EAC3B,0BAA0B;EAC1B,cAAc;AAChB;AACA,2CAA2C,sBAAsB,EAAE;;AAEnE,sBAAsB,kBAAkB,EAAE,SAAS,EAAE,WAAW,EAAE,iBAAiB,EAAE,mBAAmB,EAAE,kBAAkB,EAAE,gBAAgB,EAAE,WAAW,EAAE;;AAE7J,kBAAkB,aAAa,EAAE,aAAa,EAAE,sBAAsB,EAAE,YAAY,EAAE,SAAO,EAAE;AAC/F,qBAAqB,eAAe,EAAE,gBAAgB,EAAE,cAAc,EAAE;AACxE,mBAAmB,iBAAiB,EAAE,cAAc,EAAE,gBAAgB,EAAE;AACxE,sBAAsB,kBAAkB,EAAE,WAAW,EAAE;AACvD,kBAAkB,kBAAkB,EAAE,WAAW,EAAE,gBAAgB,EAAE,kBAAkB,EAAE,oBAAoB,EAAE,qBAAqB,EAAE,4BAA4B,EAAE,gBAAgB,EAAE;;AAEtL,oBAAoB,aAAa,EAAE,8BAA8B,EAAE,mBAAmB,EAAE,gBAAgB,EAAE,mBAAmB,EAAE,6BAA6B,EAAE;AAC9J,uBAAuB,kBAAkB,EAAE,WAAW,EAAE;AACxD,kBAAkB,iBAAiB,EAAE,gBAAgB,EAAE,cAAc,EAAE","sourcesContent":[".baba-card {\n  display: flex; flex-direction: column;\n  background: #141414; border: 1px solid #1e1e1e;\n  border-radius: 12px; overflow: hidden;\n  transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;\n  cursor: pointer;\n}\n.baba-card:hover {\n  transform: translateY(-4px);\n  border-color: #FF6B00;\n  box-shadow: 0 8px 30px rgba(255,107,0,0.15);\n}\n\n.baba-card-img-wrap {\n  position: relative;\n  height: 260px;\n  overflow: hidden;\n  background: #1a1a1a;\n}\n.baba-card-img-wrap img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: center top;\n  transition: transform 0.3s;\n  display: block;\n}\n.baba-card:hover .baba-card-img-wrap img { transform: scale(1.05); }\n\n.baba-card-category { position: absolute; top: 10px; right: 10px; padding: 3px 10px; border-radius: 20px; font-size: 0.72rem; font-weight: 600; color: #fff; }\n\n.baba-card-body { padding: 1rem; display: flex; flex-direction: column; gap: 0.35rem; flex: 1; }\n.baba-card
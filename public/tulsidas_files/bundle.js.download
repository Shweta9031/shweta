AE;AACnD,yBAAyB,WAAW,EAAE,kBAAkB,EAAE,qBAAqB,EAAE,sBAAsB,EAAE;AACzG,+BAA+B,cAAc,EAAE;;AAE/C;EACE,gBAAgB,8BAA8B,EAAE,SAAS,EAAE;EAC3D,gBAAgB,mBAAmB,EAAE;AACvC;AACA;EACE,gBAAgB,0BAA0B,EAAE;EAC5C,gBAAgB,iBAAiB,EAAE;EACnC,uBAAuB,sBAAsB,EAAE,kBAAkB,EAAE;EACnE,cAAc,yBAAyB,EAAE;AAC3C","sourcesContent":[".footer { background: #080808; border-top: 1px solid #2a1200; margin-top: 4rem; }\n\n.footer-top { padding: 4rem 2rem 3rem; border-bottom: 1px solid #111; }\n\n.footer-inner {\n  max-width: 1200px; margin: 0 auto;\n  display: grid; grid-template-columns: 2fr 1fr 1fr 1.6fr;\n  gap: 3rem; align-items: start;\n}\n\n.footer-brand { display: flex; flex-direction: column; gap: 1rem; }\n.footer-logo { display: flex; align-items: center; gap: 0.6rem; }\n.footer-om { font-size: 2rem; }\n\n.footer-name {\n  font-size: 1.5rem; font-weight: 800;\n  background: linear-gradient(135deg, #FF6B00, #FFD700);\n  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\n}\n\n.footer-tagline { color: #777; font-size: 0.88rem; line-height: 1.75; max-width: 300px; }\n\n.footer-socials { display: flex; gap: 0.6rem; }\n\n.footer-social-btn {\n  width: 38px; height: 38px; border-radius: 8px;\n  background: #141414; border: 1px solid #1e1e1e;\n  display: flex; align-items: center; justify-content: center;\n  font-size: 1rem; text-decoration: none;\n  transition: border-color 0.2s, background 0.2s, transform 0.2s;\n}\n.footer-social-btn:hover {\n  border-color: #FF6B00;\n  background: rgba(255,107,0,0.1);\n  transform: translateY(-2px);\n}\n\n.footer-mantras { display: flex; flex-wrap: wrap; gap: 0.5rem; }\n.footer-mantras span {\n  font-size: 0.72rem; color: #FF9933;\n  background: rgba(255,107,0,0.08);\n  border: 1px solid rgba(255,107,0,0.2);\n  padding: 3px 10px; border-radius: 20px; font-weight: 500;\n}\n\n.footer-col { display: flex; flex-direction: column; gap: 1rem; }\n\n.footer-col-title {\n  font-size: 0.85rem; font-weight: 700; color: #fff5e6;\n  text-transform: uppercase; letter-spacing: 0.08em;\n  padding-bottom: 0.6rem; border-bottom: 1px solid #1a1a1a;\n}\n\n.footer-col-list { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }\n\n.footer-col-list li a {\n  color: #777; font-size: 0.87rem; text-decoration: none;\n  transition: color 0.2s; display: flex; align-items: center; gap: 0.4rem;\n}\n.footer-col-list li a:hover { color: #FF6B00; }\n\n.footer-link-arrow { color: #FF6B00; font-size: 1rem; line-height: 1; }\n\n.footer-contact-list { list-style: none; display: flex; flex-direction: column; gap: 0.7rem; }\n.footer-contact-list li {\n  display: flex; align-items: flex-start; gap: 0.6rem;\n  font-size: 0.83rem; color: #777; line-height: 1.5;\n}\n.footer-contact-list li span:first-child { flex-shrink: 0; font-size: 0.9rem; }\n\n.footer-newsletter { margin-top: 0.5rem; }\n.footer-newsletter p { font-size: 0.78rem; color: #666; margin-bottom: 0.6rem; }\n\n.footer-newsletter-form {\n  display: flex; border-radius: 8px; overflow: hidden; border: 1px solid #2a1200;\n}\n.footer-newsletter-form input {\n  flex: 1; background: #141414; border: none;\n  padding: 0.6rem 0.8rem; color: #fff5e6;\n  font-size: 0.82rem; outline: none; font-family: inherit;\n}\n.footer-newsletter-form input::placeholder { color: #444; }\n.footer-newsletter-form button {\n  background: linear-gradient(135deg, #FF6B00, #FF9933);\n  border: none; padding: 0.6rem 1rem; color: #fff;\n  font-size: 0.8rem; font-weight: 600; cursor: pointer;\n  font-family: inherit; transition: opacity 0.2s; white-space: nowrap;\n}\n.footer-newsletter-form button:hover { opacity: 0.88; }\n\n.footer-bottom { padding: 1.2rem 2rem; background: #050505; }\n.footer-bottom-inner {\n  max-width: 1200px; margin: 0 auto;\n  display: flex; justify-content: space-between; align-items: center;\n  gap: 1rem; flex-wrap: wrap;\n}\n.footer-bottom p { color: #444; font-size: 0.78rem; }\n.footer-bottom-links { display: flex; gap: 1.5rem; }\n.footer-bottom-links a { color: #444; font-size: 0.78rem; text-decoration: none; transition: color 0.2s; }\n.footer-bottom-links a:hover { color: #FF6B00; }\n\n@media (max-width: 1024px) {\n  .footer-inner { grid-template-columns: 1fr 1fr; gap: 2rem; }\n  .footer-brand { grid-column: 1 / -1; }\n}\n@media (max-width: 600px) {\n  .footer-inner { grid-template-columns: 1fr; }\n  .footer-brand { grid-column: auto; }\n  .footer-bottom-inner { flex-direction: column; text-align: center; }\n  .footer-top { padding: 3rem 1.5rem 2rem; }\n}\n"],"sourceRoot":""}]);
